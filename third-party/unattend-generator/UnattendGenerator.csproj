<Project Sdk="Microsoft.NET.Sdk">

  <!-- VirtDeck local delta, and the only one in this vendored copy: upstream multi-targets
       net8.0;net9.0;net10.0, and nothing in VirtDeck.sln consumes the other two. See VENDORED.md.

       RootNamespace and AssemblyName are load-bearing, not style. resource/Bloatware.json carries
       Newtonsoft $type discriminators of the form
       "Schneegans.Unattend.CapabilityBloatwareStep, UnattendGenerator", so both names are baked
       into the data: rename either and the very first `new UnattendGenerator()` throws, at runtime
       only. AssemblyName is stated explicitly rather than left to derive from the file name.

       CheckForOverflowUnderflow is upstream's and stays: Validation.cs's range checks want the
       throw, not a silent wrap. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
    <OutputType>Library</OutputType>
    <RootNamespace>Schneegans.Unattend</RootNamespace>
    <AssemblyName>UnattendGenerator</AssemblyName>
    <Nullable>enable</Nullable>

    <!-- BuildModifier stamps the generator's commit into every answer file, reading it out of
         AssemblyInformationalVersionAttribute as "...+<40 hex>". The .NET 8+ SDK has SourceLink
         built in and fills that suffix from the enclosing git repo, which here is VirtDeck: left
         alone, every answer disc claims to have been generated by a cschneegans commit that does
         not exist, under a github.com URL that 404s. So the suffix is switched off and the version
         states the commit this directory was actually copied from. Keep it in step with
         VENDORED.md; the answer file is then self-describing about which generator wrote it. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <InformationalVersion>0.0.0+427480c7be47e8bd1301b89747baab38271b3da3</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="resource\AppLocker.xsd" />
    <None Remove="resource\DesktopIcon.json" />
    <None Remove="resource\MakeEdgeUninstallable.ps1" />
    <None Remove="resource\MoveActiveHours.xml" />
    <None Remove="resource\PauseWindowsUpdate.xml" />
    <None Remove="resource\RemoveBloatware.ps1" />
    <None Remove="resource\RemoveCapabilities.ps1" />
    <None Remove="resource\RemoveFeatures.ps1" />
    <None Remove="resource\RemovePackages.ps1" />
    <None Remove="resource\RestartExplorer.ps1" />
    <None Remove="resource\SetColorTheme.ps1" />
    <None Remove="resource\SetComputerName.ps1" />
    <None Remove="resource\SetStartPins.ps1" />
    <None Remove="resource\ShowAllTrayIcons.ps1" />
    <None Remove="resource\ShowAllTrayIcons.xml" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="resource\AppLocker.xsd" />
    <EmbeddedResource Include="resource\autounattend.xml" />
    <EmbeddedResource Include="resource\autounattend.xsd" />
    <EmbeddedResource Include="resource\Component.json" />
    <EmbeddedResource Include="resource\DesktopIcon.json" />
    <EmbeddedResource Include="resource\ExtractScripts.ps1" />
    <EmbeddedResource Include="resource\GeoId.json" />
    <EmbeddedResource Include="resource\ImageLanguage.json" />
    <EmbeddedResource Include="resource\KeyboardIdentifier.json" />
    <EmbeddedResource Include="resource\Bloatware.json" />
    <EmbeddedResource Include="resource\UnlockStartLayout.xml" />
    <EmbeddedResource Include="resource\MoveActiveHours.xml" />
    <EmbeddedResource Include="resource\PauseWindowsUpdate.xml" />
    <EmbeddedResource Include="resource\RestartExplorer.ps1" />
    <EmbeddedResource Include="resource\SetComputerName.ps1" />
    <EmbeddedResource Include="resource\SetColorTheme.ps1" />
    <EmbeddedResource Include="resource\SetWallpaper.ps1" />
    <EmbeddedResource Include="resource\MakeEdgeUninstallable.ps1" />
    <EmbeddedResource Include="resource\SetStartPins.ps1" />
    <EmbeddedResource Include="resource\UnlockStartLayout.vbs" />
    <EmbeddedResource Include="resource\ShowAllTrayIcons.ps1" />
    <EmbeddedResource Include="resource\RemoveBloatware.ps1" />
    <EmbeddedResource Include="resource\ShowAllTrayIcons.xml" />
    <EmbeddedResource Include="resource\TimeOffset.json" />
    <EmbeddedResource Include="resource\TurnOffSystemSounds.ps1" />
    <EmbeddedResource Include="resource\UserLocale.json" />
    <EmbeddedResource Include="resource\VirtIoGuestTools.ps1" />
    <EmbeddedResource Include="resource\ParallelsTools.ps1" />
    <EmbeddedResource Include="resource\StartFolder.json" />
    <EmbeddedResource Include="resource\VMwareTools.ps1" />
    <EmbeddedResource Include="resource\VBoxGuestAdditions.ps1" />
    <EmbeddedResource Include="resource\WindowsEdition.json" />
    <EmbeddedResource Include="resource\WLANProfile.xml" />
    <EmbeddedResource Include="resource\WLAN_profile_v1.xsd" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

</Project>
