<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>VirtDeck</RootNamespace>
    <AssemblyName>virtdeck</AssemblyName>
    <ApplicationIcon>Icons\appicon.ico</ApplicationIcon>
    <!-- The native USB libraries (libusb-1.0 / usbredirhost) are 64-bit, so the app must run
         as x64. RuntimeIdentifiers enables `dotnet publish -r win-x64` for the installer. -->
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SSH.NET" Version="2024.2.0" />
    <PackageReference Include="System.IO.Pipelines" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SpiceClient\SpiceClient.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Icons\*.png" />
    <!-- The window icon, loaded at runtime via AppIcons.App and set on every AppForm. The
         same .ico is also baked into the exe as the shell icon by <ApplicationIcon> above. -->
    <EmbeddedResource Include="Icons\appicon.ico" />
    <!-- Fallback osinfo short-id → label map, read by OsLabelCatalog when the host has no
         live osinfo-query to enrich the Create-VM OS dropdown. -->
    <EmbeddedResource Include="Data\*.json" />
  </ItemGroup>

  <!-- Native USB redirection libraries (x64), hand-staged outside the project (see
       ..\native\win-x64\VERSIONS.txt). Copied flat next to VirtDeck.exe so libusb-1.0.dll /
       usbredirhost.dll / usbredirparser.dll (+ MinGW runtime deps) resolve by bare DllImport
       name on both `dotnet build` and `dotnet publish -r win-x64`. The glob matches nothing
       until the binaries are staged, so the build still succeeds without them. -->
  <ItemGroup>
    <None Include="..\native\win-x64\*.dll">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Pack>false</Pack>
    </None>
  </ItemGroup>

</Project>
