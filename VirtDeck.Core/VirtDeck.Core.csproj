<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Namespaces stay VirtDeck.* so both the WinForms and Avalonia front-ends
         reference this without touching a single using directive. -->
    <RootNamespace>VirtDeck</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- System.IO.Pipelines and Microsoft.Win32.Registry (used by LegacyRegistryImport) are both
         in the net10.0 shared framework, no PackageReference needed. -->
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SpiceClient\SpiceClient.csproj" />
    <ProjectReference Include="..\third-party\unattend-generator\UnattendGenerator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Fallback osinfo short-id → label map, read by OsLabelCatalog when the host has no
         live osinfo-query to enrich the Create-VM OS dropdown. Resolved by name suffix, so
         it works from whichever assembly it is embedded in. -->
    <EmbeddedResource Include="Data\*.json" />

    <!-- The Remote Control module's host agent (one static virtdeck-agent), one tarball per
         host architecture, built by native/agent/build.sh and uploaded to the host on first use.
         Every build carries both, Windows included: they go to a Linux host, whatever this one is.
         Named by architecture alone so RemoteDesktopService finds them without a manifest. -->
    <EmbeddedResource Include="..\native\agent\agent-*.tar.gz" LogicalName="VirtDeck.Agent.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
