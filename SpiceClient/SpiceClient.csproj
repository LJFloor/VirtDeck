<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Cross-platform: the protocol engine has no OS dependency. The Windows-only pieces
         (winmm audio, the UsbDk libusb backend) are selected at runtime, not by the TFM. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- JPEG decode (SPICE_IMAGE_TYPE_JPEG and MJPEG streams). Skia is what Avalonia renders with
         anyway, so this costs nothing at runtime and replaces GDI+/System.Drawing.Common. Note that
         System.Drawing.Primitives (Rectangle) is cross-platform BCL and is still used for dirty rects. -->
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4" />
    <!-- Pure-C# Opus decoder for the SPICE playback channel (no native DLL to stage). BSD/libopus terms. -->
    <PackageReference Include="Concentus" Version="2.2.2" />
  </ItemGroup>

</Project>
