<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fluent="clr-namespace:Avalonia.Themes.Fluent;assembly=Avalonia.Themes.Fluent"
             xmlns:edit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             xmlns:unattend="clr-namespace:VirtDeck.Avalonia.Views.Unattend"
             x:Class="VirtDeck.Avalonia.App"
             RequestedThemeVariant="Default">
  <!-- The answer-file window's four checklist pages (bloatware, desktop icons, folders on Start,
       visual effects) and the user module's group membership list all render the same row, so the
       template lives here once instead of in each page's resources. They differ only in the catalog
       they fill from and the column width they flow into, both of which are set on the ItemsControl.

       The Border is load-bearing, not padding: a disabled control is not hit-testable in Avalonia,
       so the tooltip saying why a row cannot be ticked has to hang off an enabled parent. Hint is
       null everywhere except the primary group row, so nothing appears anywhere else. -->
  <Application.DataTemplates>
    <DataTemplate DataType="unattend:CheckRow">
      <Border ToolTip.Tip="{Binding Hint}" Background="Transparent">
        <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                  IsEnabled="{Binding IsEnabled}" />
      </Border>
    </DataTemplate>
  </Application.DataTemplates>

  <!-- Buttons and text fields in JetBrains Classic UI trim. Merged here, not into
       Application.Styles, so its TextControl* keys resolve ahead of FluentTheme's. -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://virtdeck/Styles/JetBrainsClassic.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <!-- Fluent's stock dark variant is near-black (#000 chrome on a #000 window). Repaint it with a
         neutral dark-gray ramp in the Discord/JetBrains register: #313338 surface, #2B2D31 chrome,
         #1E1F22 as the darkest step. Only the Dark palette is overridden; Light keeps its defaults. -->
    <FluentTheme>
      <FluentTheme.Palettes>
        <fluent:ColorPaletteResources x:Key="Dark"
                                      RegionColor="#FF313338"

                                      AltHigh="#FF2B2D31"
                                      AltMediumHigh="#CC2B2D31"
                                      AltMedium="#992B2D31"
                                      AltMediumLow="#662B2D31"
                                      AltLow="#332B2D31"

                                      BaseHigh="#FFF2F3F5"
                                      BaseMediumHigh="#FFDBDEE1"
                                      BaseMedium="#FFB5BAC1"
                                      BaseMediumLow="#FF949BA4"
                                      BaseLow="#FF4E5058"

                                      ChromeWhite="#FFFFFFFF"
                                      ChromeAltLow="#FFDBDEE1"
                                      ChromeHigh="#FF80848E"
                                      ChromeGray="#FF80848E"
                                      ChromeMediumLow="#FF35373C"
                                      ChromeMedium="#FF2B2D31"
                                      ChromeLow="#FF1E1F22"
                                      ChromeDisabledHigh="#FF4E5058"
                                      ChromeDisabledLow="#FF80848E"
                                      ChromeBlackHigh="#FF1E1F22"
                                      ChromeBlackMedium="#FF1E1F22"
                                      ChromeBlackMediumLow="#FF1E1F22"
                                      ChromeBlackLow="#FFB5BAC1"

                                      ListLow="#FF383A40"
                                      ListMedium="#FF404249" />
      </FluentTheme.Palettes>
    </FluentTheme>

    <!-- One taskbar/title-bar icon for every window, set here rather than repeated in fourteen
         .axaml files. Icon is a styled property, so a Style reaches it. The PNG is used instead
         of the .ico because Skia (Avalonia's decoder on Linux) does not read ICO. -->
    <Style Selector="Window">
      <Setter Property="Icon" Value="/Assets/virtdeck-256.png" />
    </Style>

    <!-- NumericUpDown draws itself inside a ButtonSpinner, whose height Fluent sets in its own
         ControlTheme rather than from the TextControl* keys the resource dictionary retunes. Pinned
         to the field height here so a spinner never stands proud of the text boxes beside it; a
         Style is the right lever because it outranks the ControlTheme setter it is correcting. -->
    <Style Selector="ButtonSpinner, NumericUpDown">
      <Setter Property="MinHeight" Value="{DynamicResource TextControlThemeMinHeight}" />
    </Style>

    <!--
      The gutter between one table column and the next, said once for all thirteen of them.

      A cell used to start its text hard against the column line to its left, so a value ran up
      against the end of the one beside it and a sorted heading's hover began exactly where its
      label did. This is the row half of it; Controls/ColumnHeader carries the same six pixels on
      the heading, so a column and its heading stay aligned to the pixel.

      The first cell is excluded because the table's own margin already insets it: JbTableRow's
      12px and the heading strip's matching 12 are what the leftmost column sits behind, and adding
      a gutter on top would push it out of line with the strip above it. The file explorer's row is
      the one written as a DockPanel, and there its direct TextBlock children are exactly the
      columns docked from the right, its name cell being a Panel; so it needs no nth-child rule and
      would be wrong with one, its leftmost column being the last child rather than the first.
    -->
    <Style Selector="StackPanel.cells > TextBlock:not(:nth-child(1))">
      <Setter Property="Padding" Value="6,0,0,0" />
    </Style>
    <Style Selector="StackPanel.cells > Border:not(:nth-child(1))">
      <Setter Property="Padding" Value="6,0,0,0" />
    </Style>
    <Style Selector="DockPanel.cells > TextBlock">
      <Setter Property="Padding" Value="6,0,0,0" />
    </Style>

    <!-- The class vocabulary the answer-file window's section pages are written in. -->
    <StyleInclude Source="avares://virtdeck/Styles/UnattendPage.axaml" />

    <!-- AvaloniaEdit brings its own control theme and there is nowhere else to merge it. Used by
         the compose editor on the Containers module's Stacks tab and by every script and markup box
         in the answer-file window. -->
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />

    <!-- Every code box in the app is monospaced at the one font baseline, which AvaloniaEdit's own
         theme knows nothing about. Here rather than in UnattendPage.axaml because the compose
         editor is not an answer-file page and this is the one rule the two share; the metrics of an
         embedded box are that file's .script class. Options and colours cannot be set from a style
         and are in Controls/CodeEditor. -->
    <Style Selector="edit|TextEditor">
      <Setter Property="FontFamily" Value="monospace" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="LineNumbersForeground" Value="{DynamicResource JbCodeLineNumber}" />
    </Style>
  </Application.Styles>
</Application>
