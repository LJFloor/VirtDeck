<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:VirtDeck.Avalonia.Views"
             xmlns:c="clr-namespace:VirtDeck.Avalonia.Controls"
             xmlns:m="clr-namespace:VirtDeck.Models;assembly=VirtDeck.Core"
             x:Class="VirtDeck.Avalonia.Views.SoftwareUpdatesModule"
             x:DataType="vm:UpdateRow">

  <UserControl.Resources>
    <!-- One column layout shared by each header strip and its rows, so they stay aligned. Prefixed
         per tab, because the two tables have nothing to do with each other. -->
    <x:Double x:Key="ColPackage">240</x:Double>
    <x:Double x:Key="ColCurrent">170</x:Double>
    <x:Double x:Key="ColNew">170</x:Double>
    <x:Double x:Key="ColSeverity">80</x:Double>

    <x:Double x:Key="ColWhen">150</x:Double>
    <x:Double x:Key="ColAction">150</x:Double>

    <!-- Refresh is the app's one arc glyph; the whole account of how it is drawn is in
         FileExplorerModule.axaml, where it first appeared. -->
    <StreamGeometry x:Key="IconRefresh">M13,8 A5,5 0 1 1 11.54,4.46 L13,5.78 M13,3 V5.78 H10.22</StreamGeometry>
  </UserControl.Resources>

  <!-- The Settings page is an ItemsControl over groups of rows, so these five are the page. They sit
       on the UserControl rather than on the controls that use them so there is one copy of each, and
       Avalonia picks between the four row templates off DataType alone: nothing in the view switches
       on a setting's kind, and nothing in it names apt, dnf or pacman. Every template states its own
       x:DataType, because compiled bindings are on and the root declares UpdateRow. -->
  <UserControl.DataTemplates>

    <DataTemplate DataType="vm:PackageSettingGroupRow">
      <HeaderedContentControl Theme="{StaticResource JbGroupBox}" Header="{Binding Title}">
        <StackPanel Classes="options">

          <!-- The hint describes what the group is a view of, so it is drawn only where there is
               something to view: on a group the host cannot support the reason says everything, and
               the two together read as the same fact twice. -->
          <TextBlock Classes="note" Text="{Binding Hint}" IsVisible="{Binding HasHint}" />

          <!-- A group nothing on this host can act on says so, and that sentence is the whole content
               where there are no rows behind it: the Automatic updates group on an Arch host. -->
          <TextBlock Classes="note" Text="{Binding UnavailableReason}"
                     IsVisible="{Binding IsUnavailable}" />

          <Button Content="{Binding InstallLabel}" IsVisible="{Binding CanInstall}"
                  HorizontalAlignment="Left" Click="InstallSupportClicked"
                  ToolTip.Tip="Installs it with this host's own package manager, and reads the page
                               again afterwards." />

          <!-- One IsEnabled over the subtree, which is what StackPanel.under is for one option: a
               group the host cannot support greys whole rather than row by row. -->
          <ItemsControl ItemsSource="{Binding Rows}" IsEnabled="{Binding IsEditable}" />

        </StackPanel>
      </HeaderedContentControl>
    </DataTemplate>

    <!-- Every row is wrapped in a transparent Border carrying the tooltip, because a disabled control
         is not hit-testable in Avalonia and the reason it is disabled is the thing most worth reading.
         Same workaround as CheckRow's template and the Install security updates button above. -->
    <!-- The box carries its own label, which is the container edit screen's checkbox and not the
         label column the three rows below use. A tick needs no column to line up in: its control is
         one glyph at the left margin, so a 220-wide label in front of it only pushes the box away
         from the text it applies to. -->
    <DataTemplate DataType="vm:ToggleSettingRow">
      <Border Background="Transparent" ToolTip.Tip="{Binding Hint}">
        <CheckBox Content="{Binding Label}" IsChecked="{Binding IsOn, Mode=TwoWay}"
                  IsEnabled="{Binding IsEditable}" Margin="0,0,0,2" />
      </Border>
    </DataTemplate>

    <DataTemplate DataType="vm:NumberSettingRow">
      <Border Background="Transparent" ToolTip.Tip="{Binding Hint}">
        <Grid ColumnDefinitions="220,Auto,*" Margin="0,0,0,2">
          <TextBlock Grid.Column="0" Text="{Binding Label}" TextWrapping="Wrap"
                     VerticalAlignment="Center" />
          <NumericUpDown Grid.Column="1" Width="150" Increment="1" FormatString="0"
                         Value="{Binding Number, Mode=TwoWay}"
                         Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                         IsEnabled="{Binding IsEditable}" />
          <TextBlock Grid.Column="2" Text="{Binding Unit}" Opacity="0.7" Margin="8,0,0,0"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate DataType="vm:ChoiceSettingRow">
      <Border Background="Transparent" ToolTip.Tip="{Binding Hint}">
        <Grid ColumnDefinitions="220,*" Margin="0,0,0,2">
          <TextBlock Grid.Column="0" Text="{Binding Label}" TextWrapping="Wrap"
                     VerticalAlignment="Center" />
          <!-- Bound to the choice itself and not to an index, so nothing here depends on the order
               the manager listed them in. -->
          <ComboBox Grid.Column="1" HorizontalAlignment="Left" MinWidth="280"
                    ItemsSource="{Binding Choices}"
                    SelectedItem="{Binding Selected, Mode=TwoWay}"
                    IsEnabled="{Binding IsEditable}">
            <ComboBox.ItemTemplate>
              <DataTemplate DataType="m:SettingChoice">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </Grid>
      </Border>
    </DataTemplate>

    <!-- The one row whose control is not the value. The entries are stated beside the button rather
         than behind it, because a page about automatic updates with no visible answer to which
         updates would be the biggest hole in it; the button is what opens the window that edits
         them. Trimmed rather than wrapped, so a long list cannot push the rows below it apart. -->
    <DataTemplate DataType="vm:ListSettingRow">
      <Border Background="Transparent" ToolTip.Tip="{Binding Hint}">
        <Grid ColumnDefinitions="220,Auto,*" Margin="0,0,0,2">
          <TextBlock Grid.Column="0" Text="{Binding Label}" TextWrapping="Wrap"
                     VerticalAlignment="Center" />
          <!-- The button sits against the value and not out at the page's edge: it is what edits
               that text, and a Grid star between them would put half the window in between. -->
          <TextBlock Grid.Column="1" Text="{Binding Summary}" MinWidth="280" MaxWidth="440"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                     Classes.stated="{Binding IsEmpty}" ToolTip.Tip="{Binding Summary}" />
          <Button Grid.Column="2" Content="Edit" Click="EditListClicked" Margin="8,0,0,0"
                  IsEnabled="{Binding IsEditable}" HorizontalAlignment="Left" />
        </Grid>
      </Border>
    </DataTemplate>

    <!-- A read-only text row stays enabled and becomes IsReadOnly instead, so its value can still be
         selected and copied: the one row that uses it is apt's allowed origins, which is long, is the
         answer to "which updates", and is the thing somebody will want to paste somewhere. -->
    <DataTemplate DataType="vm:TextSettingRow">
      <Border Background="Transparent" ToolTip.Tip="{Binding Hint}">
        <Grid ColumnDefinitions="220,*" Margin="0,0,0,2">
          <TextBlock Grid.Column="0" Text="{Binding Label}" TextWrapping="Wrap"
                     VerticalAlignment="Center" />
          <TextBox Grid.Column="1" HorizontalAlignment="Left" MinWidth="280" MaxWidth="440"
                   Text="{Binding Text, Mode=TwoWay}"
                   IsReadOnly="{Binding !IsEditable}"
                   Classes.stated="{Binding !IsEditable}" />
        </Grid>
      </Border>
    </DataTemplate>

  </UserControl.DataTemplates>

  <UserControl.Styles>
    <!-- The amber a security row wears, literal rather than themed for the reason the state dots
         are: it is the app's transient amber and it has to mean the same thing on either face. A
         class rather than a brush bound off the row, because an ordinary row wants the inherited
         theme foreground and a binding answering null for it would leave the cell unpainted instead
         of leaving it alone. Same shape as the Images table's Unused column. -->
    <Style Selector="TextBlock.security">
      <Setter Property="Foreground" Value="#D68F00" />
    </Style>

    <!-- A settings row that states a value rather than offering to change it. It stays a TextBox and
         stays enabled, so the text is still selectable and copyable, which is the whole point for
         apt's allowed origins; what goes is the frame that makes a box look like an invitation. -->
    <Style Selector="TextBox.stated">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Opacity" Value="0.75" />
    </Style>
  </UserControl.Styles>

  <!-- The transfer strip is outside the tabs and the tabs are inside this panel, because an upgrade
       started on the updates page has to stay visible and stay cancellable if somebody steps over to
       the history page while it runs. Same reason the containers module puts its strip here. -->
  <DockPanel>

    <!-- The progress-and-cancel strip: the same shape ConsoleWindow, the file explorer and the
         containers module draw, so the app has one look for "something is running" rather than four.
         Hidden whenever nothing is. -->
    <Border Name="XferPanel" DockPanel.Dock="Bottom" IsVisible="False"
            Padding="8" BorderThickness="0,1,0,0" BorderBrush="#22808080">
      <DockPanel>
        <!-- The Border is load-bearing and not padding: a disabled control is not hit-testable in
             Avalonia, so the tooltip explaining why Cancel has gone away has to hang off an enabled
             parent. Same workaround as CheckRow's template and ServiceRow's autostart tick. -->
        <Border DockPanel.Dock="Right" Background="Transparent" Margin="8,0,0,0"
                ToolTip.Tip="{Binding #CancelXferButton.Tag}">
          <Button Name="CancelXferButton" Content="Cancel"
                  Theme="{StaticResource JbStatusBarButton}" />
        </Border>
        <ProgressBar Name="XferProgress" DockPanel.Dock="Right" Width="160" Height="6"
                     Minimum="0" Maximum="1000" IsIndeterminate="True"
                     VerticalAlignment="Center" Margin="8,0,0,0" />
        <TextBlock Name="XferText" Opacity="0.75" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <!-- No Theme, so this picks up the implicit top-placed JetBrains strip, exactly as the user
         accounts, services and containers modules do. JbSideTabControl and JbModuleTabControl are the
         vertical pair and belong to the shell's side menu and the answer-file window.

         The tab strip is the top of the module and each page carries its own toolbar, so a toolbar
         only ever shows what applies to the table under it. -->
    <TabControl Name="Tabs">

      <TabItem Header="Available updates">
        <DockPanel>

          <Border DockPanel.Dock="Top" Padding="8" BorderThickness="0,0,0,1" BorderBrush="#22808080">
            <DockPanel>
              <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="6">
                <!-- Accented, following the Images page's Pull rather than the strict reading of the
                     rule: this is the one command on the page that brings something new onto the
                     host. -->
                <Button Name="InstallAllButton" Content="Install all updates" Classes="accent" />

                <!-- Disabled with its reason on hover on a pacman host, never hidden: a command
                     somebody goes looking for must not come and go. -->
                <Border Background="Transparent" ToolTip.Tip="{Binding #InstallSecurityButton.Tag}">
                  <Button Name="InstallSecurityButton" Content="Install security updates" />
                </Border>

                <!-- A real Refresh button, as in the file explorer and the accounts module: nothing
                     on the host announces that a mirror published a package, so there is no event
                     tail here and no poll either. -->
                <Border Background="Transparent" ToolTip.Tip="{Binding #RefreshButton.Tag}">
                  <Button Name="RefreshButton" Theme="{StaticResource JbIconButton}">
                    <Path Data="{StaticResource IconRefresh}" Width="16" Height="16"
                          Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.2" />
                  </Button>
                </Border>
              </StackPanel>
              <c:FilterBox DockPanel.Dock="Right" Name="UpdateSearch" Width="200" Margin="10,0,0,0"
                           PlaceholderText="Search packages"
                           ToolTip.Tip="Narrows the table in hand (Ctrl+F). Matches the package name and the repository." />
              <Panel />
            </DockPanel>
          </Border>

          <!-- The reboot notice. Page content rather than an IModule.StatusWidget: that slot is for a
               fact about the host neither table owns (the containers module's Hub account), and this
               one belongs to the page it appears on and disappears again with. -->
          <Border Name="RebootPanel" DockPanel.Dock="Top" IsVisible="False"
                  Padding="12,8" Background="#18D68F00"
                  BorderThickness="0,0,0,1" BorderBrush="#55D68F00">
            <DockPanel>
              <Button Name="RebootButton" DockPanel.Dock="Right" Content="Restart host"
                      Margin="10,0,0,0" VerticalAlignment="Center" />
              <TextBlock Name="RebootText" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
          </Border>

          <Border DockPanel.Dock="Top" Padding="12,3" Background="#11808080"
                  BorderThickness="0,0,0,1" BorderBrush="#22808080">
            <!-- Every cell sorts; a third click returns to this table's own order, which is security
                 first and then by name. A version sorts as the string the tool printed: comparing
                 two of them properly is per-manager arithmetic that belongs to the package tool,
                 and this column is for finding a package rather than for ranking one. -->
            <DockPanel Name="UpdateHeaderStrip">
              <c:ColumnHeader DockPanel.Dock="Left" Text="Package"    SortKey="package"    Width="{StaticResource ColPackage}" />
              <c:ColumnHeader DockPanel.Dock="Left" Text="Installed"  SortKey="installed"  Width="{StaticResource ColCurrent}" />
              <c:ColumnHeader DockPanel.Dock="Left" Text="Available"  SortKey="available"  Width="{StaticResource ColNew}" />
              <c:ColumnHeader DockPanel.Dock="Left" Text="Severity"   SortKey="severity"   Width="{StaticResource ColSeverity}" />
              <c:ColumnHeader Text="Repository" SortKey="repository" />
            </DockPanel>
          </Border>

          <Panel>
            <!-- Single selection and no context menu: there is nothing to do to one row. The table is
                 what is about to be installed, not a set of things to pick from, which is Cockpit's
                 answer too. -->
            <ListBox Name="UpdateList" Background="Transparent" Padding="0"
                     SelectionMode="Single"
                     ItemContainerTheme="{StaticResource JbTableRow}">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:UpdateRow">
                  <StackPanel Classes="cells" Orientation="Horizontal" ToolTip.Tip="{Binding Summary}">
                    <TextBlock Text="{Binding Display}" Width="{StaticResource ColPackage}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding CurrentText}" Width="{StaticResource ColCurrent}"
                               Opacity="0.75" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding NewVersion}" Width="{StaticResource ColNew}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding SeverityText}" Width="{StaticResource ColSeverity}"
                               Classes.security="{Binding IsSecurity}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Repository}" Opacity="0.75" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <!-- Why the list is empty, so a host with nothing to do and a host that could not be read
                 never look the same. -->
            <TextBlock Name="UpdatesEmpty" Opacity="0.6" IsVisible="False"
                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Panel>

        </DockPanel>
      </TabItem>

      <TabItem Header="History">
        <DockPanel>

          <Border DockPanel.Dock="Top" Padding="8" BorderThickness="0,0,0,1" BorderBrush="#22808080">
            <DockPanel>
              <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="6">
                <Button Name="RefreshHistoryButton" Theme="{StaticResource JbIconButton}"
                        ToolTip.Tip="Read the history again">
                  <Path Data="{StaticResource IconRefresh}" Width="16" Height="16"
                        Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.2" />
                </Button>
              </StackPanel>
              <Panel />
            </DockPanel>
          </Border>

          <Border DockPanel.Dock="Top" Padding="12,3" Background="#11808080"
                  BorderThickness="0,0,0,1" BorderBrush="#22808080">
            <!-- When sorts as the string it draws, which is correct because PackageScripts.When
                 normalises every manager's date to "yyyy-MM-dd HH:mm": lexicographic order already
                 is chronological order, the trade the file explorer's Modified column makes. -->
            <DockPanel Name="HistoryHeaderStrip">
              <c:ColumnHeader DockPanel.Dock="Left" Text="When"     SortKey="when"     Width="{StaticResource ColWhen}" />
              <c:ColumnHeader DockPanel.Dock="Left" Text="Action"   SortKey="action"   Width="{StaticResource ColAction}" />
              <c:ColumnHeader Text="Packages" SortKey="packages" />
            </DockPanel>
          </Border>

          <Panel>
            <ListBox Name="HistoryList" Background="Transparent" Padding="0"
                     SelectionMode="Single"
                     ItemContainerTheme="{StaticResource JbTableRow}">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:HistoryRow">
                  <StackPanel Classes="cells" Orientation="Horizontal" ToolTip.Tip="{Binding Summary}">
                    <TextBlock Text="{Binding When}" Width="{StaticResource ColWhen}"
                               Opacity="0.75" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Action}" Width="{StaticResource ColAction}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <!-- A transaction the tool reported an error for is drawn in the app's one
                         validation brush, because it is the row somebody scrolling this table is
                         looking for. -->
                    <TextBlock Text="{Binding Packages}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Classes.failed="{Binding HasError}" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
              <ListBox.Styles>
                <Style Selector="TextBlock.failed">
                  <Setter Property="Foreground" Value="{DynamicResource JbErrorForeground}" />
                </Style>
              </ListBox.Styles>
            </ListBox>

            <TextBlock Name="HistoryEmpty" Opacity="0.6" IsVisible="False"
                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Panel>

        </DockPanel>
      </TabItem>

      <TabItem Header="Settings">
        <DockPanel>

          <Border DockPanel.Dock="Top" Padding="8" BorderThickness="0,0,0,1" BorderBrush="#22808080">
            <DockPanel>
              <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="6"
                          VerticalAlignment="Center">
                <!-- No Save and no Revert: moving a control writes it. Revert went with Save rather
                     than for its own sake, since the host already holds the value by the time
                     anybody could press it; Refresh is the way back, and it says what the host
                     says. -->
                <Button Name="RefreshSettingsButton" Theme="{StaticResource JbIconButton}"
                        ToolTip.Tip="Read these settings from the host again">
                  <Path Data="{StaticResource IconRefresh}" Width="16" Height="16"
                        Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.2" />
                </Button>
                <TextBlock Name="SettingsSaveNote" Classes="note" VerticalAlignment="Center"
                           Text="Changes are saved to the host as you make them." />
              </StackPanel>
              <Panel />
            </DockPanel>
          </Border>

          <Panel>
            <ScrollViewer Padding="16">
              <!-- Classes="page" spaces a StackPanel's own children, and an ItemsControl is one
                   child however many groups are in it, so the spacing goes on the panel the items
                   are laid out in or every group box sits flush against the next. -->
              <StackPanel Classes="page">
                <ItemsControl Name="SettingsGroups">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Spacing="12" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>

            <TextBlock Name="SettingsEmpty" Opacity="0.6" IsVisible="False"
                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Panel>

        </DockPanel>
      </TabItem>

    </TabControl>
  </DockPanel>
</UserControl>
