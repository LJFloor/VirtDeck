<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:VirtDeck.Avalonia.Views"
             xmlns:c="clr-namespace:VirtDeck.Avalonia.Controls"
             x:Class="VirtDeck.Avalonia.Views.VirtualMachinesModule"
             x:DataType="vm:VmRow">

  <UserControl.Resources>
    <!-- One column layout shared by the header and every row, so they stay aligned. -->
    <x:Double x:Key="ColName">220</x:Double>
    <x:Double x:Key="ColState">100</x:Double>
    <x:Double x:Key="ColCpu">70</x:Double>
    <x:Double x:Key="ColMem">100</x:Double>
    <x:Double x:Key="ColAutostart">90</x:Double>
    <x:Double x:Key="ColNetName">220</x:Double>
    <x:Double x:Key="ColNetState">110</x:Double>
  </UserControl.Resources>

  <!-- The tab strip is the top of the module and each page carries its own commands, so a toolbar
       only ever shows what applies to the table under it. The details pane is inside the VMs page
       rather than beside the whole strip: it is about a VM, so the Networks page neither carries it
       nor pays its width. -->
  <TabControl Name="Tabs">

    <TabItem Header="Virtual machines">
      <DockPanel>
        <!-- Hardware virtualization the host cannot use. Above the commands rather than in the
             status slot beside them, because it is the one host fact that decides whether anything
             on this page works, and the fix is in the machine's firmware rather than in this app.
             The kernel's own line, where it printed one, is on the hover. -->
        <Border Name="KvmBanner" DockPanel.Dock="Top" Padding="12,8" IsVisible="False"
                Background="#22d68f00" BorderThickness="0,0,0,1" BorderBrush="#22808080">
          <TextBlock Name="KvmBannerText" VerticalAlignment="Center" TextWrapping="Wrap" />
        </Border>

        <Border DockPanel.Dock="Top" Padding="8" BorderThickness="0,0,0,1" BorderBrush="#22808080">
          <!-- Only the commands that don't need a selection live here; everything per-VM is on
               the list's right-click menu. The filter box is the services module's, and it works
               the same way: it narrows the listing already in hand and never asks the host
               anything. -->
          <DockPanel>
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="6">
              <Button Name="NewVmButton" Content="New VM" Classes="accent" />
            </StackPanel>
            <c:FilterBox DockPanel.Dock="Right" Name="VmSearch" Width="220" Margin="10,0,0,0"
                         PlaceholderText="Search VMs"
                         ToolTip.Tip="Narrows the table in hand (Ctrl+F). Matches the name." />
            <Panel />
          </DockPanel>
        </Border>

        <!-- Every cell is a ColumnHeader because every column sorts. A third click drops back
             to this table's own order, which is by name. Indent (not Margin) puts the heading
             over the rows' state dot without widening the column. -->
        <Border DockPanel.Dock="Top" Padding="12,3" Background="#11808080"
                BorderThickness="0,0,0,1" BorderBrush="#22808080">
          <DockPanel Name="VmHeaderStrip">
            <c:ColumnHeader DockPanel.Dock="Left" Text="Name"   SortKey="name"   Indent="14" Width="{StaticResource ColName}" />
            <c:ColumnHeader DockPanel.Dock="Left" Text="State"  SortKey="state"  Width="{StaticResource ColState}" />
            <c:ColumnHeader DockPanel.Dock="Left" Text="vCPUs"  SortKey="vcpus"  Width="{StaticResource ColCpu}" />
            <c:ColumnHeader DockPanel.Dock="Left" Text="Memory" SortKey="memory" Width="{StaticResource ColMem}" />
            <c:ColumnHeader DockPanel.Dock="Left" Text="Autostart" SortKey="autostart" Width="{StaticResource ColAutostart}" />
            <c:ColumnHeader Text="Uptime" SortKey="uptime" />
          </DockPanel>
        </Border>

        <!-- List, splitter, details pane. A Grid rather than a third DockPanel.Dock because a
             GridSplitter can only resize rows it is a child of. The pane's row height is restored
             from settings in the constructor and saved back on Deactivate. -->
        <Grid Name="VmSplit" RowDefinitions="*,4,200">

        <Panel Grid.Row="0">
        <ListBox Name="VmList" SelectionMode="Multiple" Background="Transparent"
                 Padding="0"
                 ItemContainerTheme="{StaticResource JbTableRow}">
          <ListBox.ContextMenu>
            <ContextMenu Name="VmMenu">
              <MenuItem Name="MenuConsole" Header="Open console" />
              <Separator />
              <MenuItem Name="MenuStart" Header="Start" />
              <MenuItem Name="MenuStop" Header="Shut down" />
              <MenuItem Name="MenuForceStop" Header="Force off" />
              <MenuItem Name="MenuReboot" Header="Reboot" />
              <Separator />
              <MenuItem Name="MenuEdit" Header="Settings" />
              <MenuItem Name="MenuExport" Header="Export VM" />
              <MenuItem Name="MenuDelete" Header="Delete" />
            </ContextMenu>
          </ListBox.ContextMenu>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="vm:VmRow">
              <StackPanel Classes="cells" Orientation="Horizontal">
                <!-- Same 9px state dot as the details pane, sharing VmRow.StateBrush. -->
                <DockPanel Width="{StaticResource ColName}">
                  <Ellipse DockPanel.Dock="Left" Width="9" Height="9" Margin="0,0,5,0"
                           VerticalAlignment="Center" Fill="{Binding StateBrush}" />
                  <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <TextBlock Text="{Binding State}"  Width="{StaticResource ColState}" Foreground="{Binding StateBrush}" />
                <TextBlock Text="{Binding VCpus}"  Width="{StaticResource ColCpu}" />
                <TextBlock Text="{Binding Memory}" Width="{StaticResource ColMem}" />
                <!-- The one cell in this table that changes something rather than reporting it, in
                     the services module's shape. The Border is load-bearing and not padding: a
                     disabled control is not hit-testable in Avalonia, so the tooltip saying why a
                     transient domain cannot autostart has to hang off an enabled parent. No word
                     beside the tick, unlike a service unit: virsh has only enable and disable, so
                     the tick already says the whole of it. -->
                <Border Width="{StaticResource ColAutostart}" Background="Transparent"
                        ToolTip.Tip="{Binding AutostartHint}">
                  <!-- OneWay is load-bearing: IsChecked binds two way by default, and a write-back
                       would flip the row under the Click handler and send the host the opposite
                       command. VmRow.AutostartOn is get-only for the same reason. -->
                  <CheckBox IsChecked="{Binding AutostartOn, Mode=OneWay}"
                            IsEnabled="{Binding AutostartChangeable}"
                            HorizontalAlignment="Left" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{Binding Uptime}" Opacity="0.75" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <!-- Why the list is empty, so a filtered-to-nothing table says so rather than looking
             like a host with no VMs on it. Hidden as soon as there is a row to show. -->
        <TextBlock Name="VmEmptyText" Opacity="0.6" IsVisible="False"
                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Panel>

        <GridSplitter Grid.Row="1" Background="#22808080" ResizeDirection="Rows" />

        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="#22808080">
          <vm:VmDetailsView Name="Details" />
        </Border>

        </Grid>
      </DockPanel>
    </TabItem>

    <!-- No toolbar on this page: every network command needs a selection and so lives on the
         right-click menu, and there is no "new network" to offer. An empty toolbar bar would be
         worse chrome than none, so the table starts directly under the tab strip. -->
    <TabItem Header="Networks">
      <DockPanel>
        <Border DockPanel.Dock="Top" Padding="12,3" Background="#11808080"
                BorderThickness="0,0,0,1" BorderBrush="#22808080">
          <DockPanel Name="NetHeaderStrip">
            <c:ColumnHeader DockPanel.Dock="Left" Text="Name"      SortKey="name"      Indent="14" Width="{StaticResource ColNetName}" />
            <c:ColumnHeader DockPanel.Dock="Left" Text="State"     SortKey="state"     Width="{StaticResource ColNetState}" />
            <c:ColumnHeader Text="Autostart" SortKey="autostart" />
          </DockPanel>
        </Border>

        <ListBox Name="NetworkList" SelectionMode="Multiple" Background="Transparent"
                 Padding="0"
                 ItemContainerTheme="{StaticResource JbTableRow}">
          <ListBox.ContextMenu>
            <ContextMenu Name="NetMenu">
              <MenuItem Name="MenuNetActivate" Header="Activate" />
              <MenuItem Name="MenuNetDeactivate" Header="Deactivate" />
              <Separator />
              <MenuItem Name="MenuNetAutostartOn" Header="Autostart on" />
              <MenuItem Name="MenuNetAutostartOff" Header="Autostart off" />
            </ContextMenu>
          </ListBox.ContextMenu>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="vm:NetworkRow">
              <StackPanel Classes="cells" Orientation="Horizontal">
                <!-- Same 9px state dot as the VMs tab, sharing NetworkRow.StateBrush. -->
                <DockPanel Width="{StaticResource ColNetName}">
                  <Ellipse DockPanel.Dock="Left" Width="9" Height="9" Margin="0,0,5,0"
                           VerticalAlignment="Center" Fill="{Binding StateBrush}" />
                  <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <TextBlock Text="{Binding State}"     Width="{StaticResource ColNetState}" Foreground="{Binding StateBrush}" />
                <TextBlock Text="{Binding Autostart}" Opacity="0.75" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </TabItem>

  </TabControl>
</UserControl>
