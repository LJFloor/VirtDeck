<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="VirtDeck.Avalonia.Views.UpgradeProgressWindow"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" CanResize="False">

  <StackPanel Margin="20" Spacing="10">
    <TextBlock Name="LineText" TextTrimming="CharacterEllipsis" />
    <ProgressBar Name="Progress" Height="6" IsIndeterminate="True" Minimum="0" Maximum="1000" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Name="BackgroundButton" Content="Background" MinWidth="88" />
      <!-- A disabled control is not hit-testable, so Cancel's reason hangs off this Border. Neither
           button is IsCancel: Escape must never stop an upgrade. -->
      <Border Background="Transparent" ToolTip.Tip="{Binding #CancelButton.Tag}">
        <Button Name="CancelButton" Content="Cancel" MinWidth="88" />
      </Border>
    </StackPanel>
  </StackPanel>
</Window>
