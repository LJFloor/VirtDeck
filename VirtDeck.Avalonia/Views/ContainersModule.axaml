<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:VirtDeck.Avalonia.Views"
             xmlns:c="clr-namespace:VirtDeck.Avalonia.Controls"
             x:Class="VirtDeck.Avalonia.Views.ContainersModule"
             x:DataType="vm:ContainerRow">

  <UserControl.Resources>
    <!-- One column layout shared by each header strip and its rows, so they stay aligned. Prefixed
         per tab, because the two tables have nothing to do with each other. -->
    <x:Double x:Key="ColName">220</x:Double>
    <x:Double x:Key="ColStack">150</x:Double>
    <x:Double x:Key="ColImage">240</x:Double>
    <x:Double x:Key="ColState">90</x:Double>
    <x:Double x:Key="ColUptime">100</x:Double>

    <x:Double x:Key="ColRepository">260</x:Double>
    <x:Double x:Key="ColTag">150</x:Double>
    <x:Double x:Key="ColImageId">110</x:Double>
    <x:Double x:Key="ColCreated">120</x:Double>
    <x:Double x:Key="ColSize">90</x:Double>

    <x:Double x:Key="ColNetName">190</x:Double>
    <x:Double x:Key="ColNetId">110</x:Double>
    <x:Double x:Key="ColNetDriver">90</x:Double>
    <x:Double x:Key="ColNetScope">70</x:Double>
    <x:Double x:Key="ColNetSubnet">150</x:Double>
    <x:Double x:Key="ColNetGateway">120</x:Double>

    <x:Double x:Key="ColStackName">200</x:Double>
    <x:Double x:Key="ColStackStatus">130</x:Double>
    <x:Double x:Key="ColStackServices">70</x:Double>
    <x:Double x:Key="ColStackSource">80</x:Double>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- The amber an image row wears when no container was created from it, and a network row
         wears when nothing is running on it: in both tables exactly what Prune would take. Literal rather than themed, for the reason the state dots are:
         it is the app's transient amber and it has to mean the same thing on either face.

         A class rather than a brush bound off the row, because the other two states want the
         inherited theme foreground and a binding that answered null for them would leave the
         text unpainted instead of leaving it alone. The cell sets no local Foreground, so this
         setter is free to win; its Opacity is bound instead (a local value would beat a
         setter). Same shape as the file explorer's cut and drop-target rows. -->
    <Style Selector="TextBlock.unused">
      <Setter Property="Foreground" Value="#D68F00" />
    </Style>
  </UserControl.Styles>

  <!-- The transfer strip is outside the tabs and the tabs are inside this panel, because a pull
       started on the Images page has to stay visible and cancellable if somebody steps over to the
       Containers page while it runs. -->
  <DockPanel>

    <!-- The transfer strip: the same shape ConsoleWindow and the file explorer draw, so the app has
         one look for "something is moving and you can stop it" rather than three. It lives in the
         module because a module owns the shell's two status slots but has no footer. Hidden whenever
         nothing is running. -->
    <Border Name="XferPanel" DockPanel.Dock="Bottom" IsVisible="False"
            Padding="8" BorderThickness="0,1,0,0" BorderBrush="#22808080">
      <DockPanel>
        <Button Name="CancelXferButton" DockPanel.Dock="Right" Content="Cancel"
                Theme="{StaticResource JbStatusBarButton}" Margin="8,0,0,0"
                ToolTip.Tip="Stop what is running" />
        <ProgressBar Name="XferProgress" DockPanel.Dock="Right" Width="160" Height="6"
                     Minimum="0" Maximum="1000" IsIndeterminate="True"
                     VerticalAlignment="Center" Margin="8,0,0,0" />
        <TextBlock Name="XferText" Opacity="0.75" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <!-- No Theme, so this picks up the implicit top-placed JetBrains strip, exactly as the user
         accounts and services modules do. JbSideTabControl and JbModuleTabControl are the vertical
         pair and belong to the shell's side menu and the answer-file window.

         The tab strip is the top of the module and each page carries its own commands, so a toolbar
         only ever shows what applies to the table under it. -->
    <TabControl Name="Tabs">

      <TabItem Header="Containers">
        <DockPanel>

          <!-- Only the command that needs no selection lives here, exactly as in the VM list;
               everything per-container is on the list's right-click menu. There is still no Refresh
               button, because `docker events` refreshes the list on its own. -->
          <Border DockPanel.Dock="Top" Padding="8" BorderThickness="0,0,0,1" BorderBrush="#22808080">
            <DockPanel>
              <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="6">
                <Button Name="NewContainerButton" Content="New container" Classes="accent" />
              </StackPanel>
              <c:FilterBox DockPanel.Dock="Right" Name="ContainerSearch" Width="200" Margin="10,0,0,0"
                           PlaceholderText="Search containers"
                           ToolTip.Tip="Narrows the table in hand (Ctrl+F). Matches the name, the image and the stack." />
              <Panel />
            </DockPanel>
          </Border>

          <Border DockPanel.Dock="Top" Padding="12,3" Background="#11808080"
                  BorderThickness="0,0,0,1" BorderBrush="#22808080">
            <!-- Every cell sorts; a third click returns to this table's own order, which is running
                 first and then by name. Indent (not Margin) puts the heading over the rows' state
                 dot without widening the column. -->
            <DockPanel Name="ContainerHeaderStrip">
              <c:ColumnHeader DockPanel.Dock="Left" Text="Name"   SortKey="name"   Indent="14" Width="{StaticResource ColName}" />
              <!-- The compose project, beside the name because it is the name's prefix whenever
                   compose chose that name, and the only place the project is stated when it did
                   not. Blank for every container compose did not create. -->
              <c:ColumnHeader DockPanel.Dock="Left" Text="Stack"  SortKey="stack"  Width="{StaticResource ColStack}" />
              <c:ColumnHeader DockPanel.Dock="Left" Text="Image"  SortKey="image"  Width="{StaticResource ColImage}" />
              <c:ColumnHeader DockPanel.Dock="Left" Text="State"  SortKey="state"  Width="{StaticResource ColState}" />
              <c:ColumnHeader DockPanel.Dock="Left" Text="Uptime" SortKey="uptime" Width="{StaticResource ColUptime}" />
              <!-- Ports is the one heading in the app that carries no order. Its cell is a
                   list rather than a value, so no ordering of it means anything; TableSort
                   skips an empty SortKey and makes the cell inert, so it does not offer. -->
              <c:ColumnHeader Text="Ports" />
            </DockPanel>
          </Border>

          <Panel>
            <ListBox Name="ContainerList" SelectionMode="Multiple" Background="Transparent"
                     Padding="0"
                     ItemContainerTheme="{StaticResource JbTableRow}">
              <ListBox.ContextMenu>
                <ContextMenu Name="ContainerMenu">
                  <MenuItem Name="MenuEdit" Header="Edit" />
                  <MenuItem Name="MenuLogs" Header="Logs" />
                  <MenuItem Name="MenuConsole" Header="Console" />
                  <Separator />
                  <MenuItem Name="MenuStart" Header="Start" />
                  <MenuItem Name="MenuStop" Header="Stop" />
                  <MenuItem Name="MenuRestart" Header="Restart" />
                  <Separator />
                  <MenuItem Name="MenuRemove" Header="Remove" />
                </ContextMenu>
              </ListBox.ContextMenu>
              <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:ContainerRow">
                  <StackPanel Classes="cells" Orientation="Horizontal">
                    <!-- Same 9px state dot as the VM list, sharing the same three colours. -->
                    <DockPanel Width="{StaticResource ColName}">
                      <Ellipse DockPanel.Dock="Left" Width="9" Height="9" Margin="0,0,5,0"
                               VerticalAlignment="Center" Fill="{Binding StateBrush}" />
                      <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <!-- The tooltip is the project in full, and adds the one thing the cell cannot
                         say for a `docker compose run` container: that it wears the label without
                         being one of the stack's services. -->
                    <TextBlock Text="{Binding Stack}"  Width="{StaticResource ColStack}" Opacity="0.75"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding StackTip}" />
                    <TextBlock Text="{Binding Image}"  Width="{StaticResource ColImage}"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Image}" />
                    <!-- Docker's own rendered phrase ("Exited (0) 2 days ago") is the tooltip: the
                         Uptime column replaces it for a running container, but the exit code of a
                         stopped one is worth keeping one hover away. -->
                    <TextBlock Text="{Binding State}"  Width="{StaticResource ColState}" Foreground="{Binding StateBrush}"
                               ToolTip.Tip="{Binding Status}" />
                    <TextBlock Text="{Binding Uptime}" Width="{StaticResource ColUptime}" Opacity="0.75" />
                    <!-- The cell is docker's phrase with the wildcard addresses, the duplicate
                         IPv6 half and an implied /tcp taken out; the tooltip is what docker
                         actually reported, the way the State cell carries its Status phrase. -->
                    <TextBlock Text="{Binding Ports}" Opacity="0.75"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding PortsReported}" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <!-- Why the list is empty, so an unusable module never just looks broken. Hidden as soon
                 as there is a row to show. -->
            <TextBlock Name="EmptyText" Opacity="0.6" IsVisible="False"
                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Panel>

        </DockPanel>
      </TabItem>

      <TabItem Header="Images">
        <DockPanel>

          <!-- The three commands that need no selection. Pull is accented because on this page it is
               the one command that brings something new in, which is what that class is for; Import
               brings something in too, but from a file somebody already has. Prune sits with them
               rather than on the menu because it applies to the whole host, not to a row. No Refresh
               button: the same `docker events` tail now carries image events. -->
          <Border DockPanel.Dock="Top" Padding="8" BorderThickness="0,0,0,1" BorderBrush="#22808080">
            <DockPanel>
              <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="6">
                <Button Name="PullImageButton" Content="Pull image" Classes="accent"
                        ToolTip.Tip="Fetch an image from a registry before anything needs it" />
                <Button Name="ImportImageButton" Content="Import"
                        ToolTip.Tip="Load a .tar or .tar.gz written by docker save" />
                <Button Name="PruneImagesButton" Content="Prune unused"
                        ToolTip.Tip="Remove images no container is using" />
              </StackPanel>
              <c:FilterBox DockPanel.Dock="Right" Name="ImageSearch" Width="200" Margin="10,0,0,0"
                           PlaceholderText="Search images"
                           ToolTip.Tip="Narrows the table in hand (Ctrl+F). Matches the repository, the tag and the image id." />
              <Panel />
            </DockPanel>
          </Border>

          <Border DockPanel.Dock="Top" Padding="12,3" Background="#11808080"
                  BorderThickness="0,0,0,1" BorderBrush="#22808080">
            <!-- Created and Size sort on the values their cells were rendered from, never on the
                 phrases docker printed: "999MB" sorts above "1.23GB" as text, and "3 weeks ago"
                 does not sort at all. A third click returns to this table's own order, tagged
                 before dangling. -->
            <DockPanel Name="ImageHeaderStrip">
              <c:ColumnHeader DockPanel.Dock="Left" Text="Repository" SortKey="repository" Width="{StaticResource ColRepository}" />
              <c:ColumnHeader DockPanel.Dock="Left" Text="Tag"        SortKey="tag"        Width="{StaticResource ColTag}" />
              <c:ColumnHeader DockPanel.Dock="Left" Text="Image ID"   SortKey="id"         Width="{StaticResource ColImageId}" />
              <c:ColumnHeader DockPanel.Dock="Left" Text="Created"    SortKey="created"    Width="{StaticResource ColCreated}" />
              <c:ColumnHeader DockPanel.Dock="Left" Text="Size"       SortKey="size"       Width="{StaticResource ColSize}" />
              <c:ColumnHeader Text="Status"     SortKey="status" />
            </DockPanel>
          </Border>

          <Panel>
            <ListBox Name="ImageList" SelectionMode="Multiple" Background="Transparent"
                     Padding="0"
                     ItemContainerTheme="{StaticResource JbTableRow}">
              <ListBox.ContextMenu>
                <ContextMenu Name="ImageMenu">
                  <MenuItem Name="MenuNewFromImage" Header="New container" />
                  <Separator />
                  <MenuItem Name="MenuExportImage" Header="Export" />
                  <MenuItem Name="MenuTagImage" Header="Tag" />
                  <Separator />
                  <MenuItem Name="MenuRemoveImage" Header="Remove" />
                </ContextMenu>
              </ListBox.ContextMenu>
              <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:ImageRow">
                  <!-- No state dot: a container is doing something, an image is a fact. A dangling
                       layer is dimmed whole instead, the way a broken symlink is in the explorer. -->
                  <StackPanel Classes="cells" Orientation="Horizontal" Opacity="{Binding RowOpacity}">
                    <TextBlock Text="{Binding Repository}" Width="{StaticResource ColRepository}"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Repository}" />
                    <TextBlock Text="{Binding Tag}"        Width="{StaticResource ColTag}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding ShortId}"    Width="{StaticResource ColImageId}" Opacity="0.75"
                               FontFamily="{DynamicResource JbMonoFont}" ToolTip.Tip="{Binding Id}" />
                    <TextBlock Text="{Binding Created}"    Width="{StaticResource ColCreated}" Opacity="0.75" />
                    <TextBlock Text="{Binding Size}"       Width="{StaticResource ColSize}" Opacity="0.75" />
                    <!-- Blank where the listing could not ask, which is a different answer from
                         "Unused" and is why the row keeps three states rather than a bool. -->
                    <TextBlock Text="{Binding Status}" Opacity="{Binding StatusOpacity}"
                               Classes.unused="{Binding IsUnused}" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Name="ImagesEmptyText" Opacity="0.6" IsVisible="False"
                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Panel>

        </DockPanel>
      </TabItem>

      <TabItem Header="Networks">
        <DockPanel>

          <!-- The two commands that need no selection. Create is accented because on this page it
               is the one command that brings something new onto the host, which is what that class
               is for. Prune sits with it rather than on the menu because it applies to the whole
               host, not to a row. No Refresh button: the same `docker events` tail now carries
               network events too. -->
          <Border DockPanel.Dock="Top" Padding="8" BorderThickness="0,0,0,1" BorderBrush="#22808080">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Name="CreateNetworkButton" Content="New network" Classes="accent"
                      ToolTip.Tip="Create a network containers can be attached to" />
              <Button Name="PruneNetworksButton" Content="Prune unused"
                      ToolTip.Tip="Remove every network no container is running on" />
            </StackPanel>
          </Border>

          <Border DockPanel.Dock="Top" Padding="12,3" Background="#11808080"
                  BorderThickness="0,0,0,1" BorderBrush="#22808080">
            <!-- A third click returns to this table's own order, user-defined before docker's
                 predefined three. No search box: a host has a handful of networks. -->
            <DockPanel Name="DockerNetHeaderStrip">
              <c:ColumnHeader DockPanel.Dock="Left" Text="Name"       SortKey="name"    Width="{StaticResource ColNetName}" />
              <c:ColumnHeader DockPanel.Dock="Left" Text="Network ID" SortKey="id"      Width="{StaticResource ColNetId}" />
              <c:ColumnHeader DockPanel.Dock="Left" Text="Driver"     SortKey="driver"  Width="{StaticResource ColNetDriver}" />
              <c:ColumnHeader DockPanel.Dock="Left" Text="Scope"      SortKey="scope"   Width="{StaticResource ColNetScope}" />
              <c:ColumnHeader DockPanel.Dock="Left" Text="Subnet"     SortKey="subnet"  Width="{StaticResource ColNetSubnet}" />
              <c:ColumnHeader DockPanel.Dock="Left" Text="Gateway"    SortKey="gateway" Width="{StaticResource ColNetGateway}" />
              <c:ColumnHeader Text="Status"     SortKey="status" />
            </DockPanel>
          </Border>

          <Panel>
            <ListBox Name="NetworkList" SelectionMode="Multiple" Background="Transparent"
                     Padding="0"
                     ItemContainerTheme="{StaticResource JbTableRow}">
              <ListBox.ContextMenu>
                <ContextMenu Name="NetworkMenu">
                  <MenuItem Name="MenuConnectContainer" Header="Connect container" />
                  <MenuItem Name="MenuDisconnectContainer" Header="Disconnect container" />
                  <Separator />
                  <MenuItem Name="MenuRemoveNetwork" Header="Remove" />
                </ContextMenu>
              </ListBox.ContextMenu>
              <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:DockerNetworkRow">
                  <!-- No state dot and no row dimming: a container is doing something, a network is
                       a fact, and unlike a dangling layer no network is a leftover. -->
                  <StackPanel Classes="cells" Orientation="Horizontal">
                    <TextBlock Text="{Binding Name}"    Width="{StaticResource ColNetName}"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                    <TextBlock Text="{Binding ShortId}" Width="{StaticResource ColNetId}" Opacity="0.75"
                               FontFamily="{DynamicResource JbMonoFont}" ToolTip.Tip="{Binding Id}" />
                    <TextBlock Text="{Binding Driver}"  Width="{StaticResource ColNetDriver}" Opacity="0.75" />
                    <TextBlock Text="{Binding Scope}"   Width="{StaticResource ColNetScope}" Opacity="0.75" />
                    <TextBlock Text="{Binding Subnet}"  Width="{StaticResource ColNetSubnet}" Opacity="0.75"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Subnet}" />
                    <TextBlock Text="{Binding Gateway}" Width="{StaticResource ColNetGateway}" Opacity="0.75"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Gateway}" />
                    <!-- Blank where the listing could not ask, which is a different answer from
                         "Unused" and is why the row keeps three states rather than a bool. The
                         tooltip is where the part Prune does not say goes: how many *stopped*
                         containers are still configured on a network with no live endpoint. -->
                    <TextBlock Text="{Binding Status}" Opacity="{Binding StatusOpacity}"
                               Classes.unused="{Binding IsUnused}"
                               ToolTip.Tip="{Binding StatusTip}" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Name="NetworksEmptyText" Opacity="0.6" IsVisible="False"
                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Panel>

        </DockPanel>
      </TabItem>

      <!-- The one page disabled whole rather than command by command: with no compose plugin the
           three commands that matter here cannot run at all. ToolTip.ShowOnDisabled is what lets it
           still say why, and it is the exception to the enabled-parent-Border rule the rest of the
           app follows, because a TabItem has no parent of its own to hang one off. -->
      <TabItem Header="Stacks" Name="StacksTab" ToolTip.ShowOnDisabled="True">
        <DockPanel>

          <!-- One command, because it is the only one on this page that needs no selection, and it
               is accented because it is the one that brings something new onto the host. Everything
               else acts on a stack and so lives on the right-click menu, which is the rule the
               Networks page above follows. -->
          <Border DockPanel.Dock="Top" Padding="8" BorderThickness="0,0,0,1" BorderBrush="#22808080">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Name="NewStackButton" Content="New stack" Classes="accent"
                      ToolTip.Tip="Write a compose file to this host and bring it up" />
            </StackPanel>
          </Border>

          <Border DockPanel.Dock="Top" Padding="12,3" Background="#11808080"
                  BorderThickness="0,0,0,1" BorderBrush="#22808080">
            <!-- Services sorts on the count the cell draws, because "10" sorts below "2" as text.
                 A third click returns to this table's own order, ours before discovered ones.
                 Indent (not Margin) puts the heading over the rows' state dot. -->
            <DockPanel Name="StackHeaderStrip">
              <c:ColumnHeader DockPanel.Dock="Left" Text="Name"         SortKey="name"     Indent="14" Width="{StaticResource ColStackName}" />
              <c:ColumnHeader DockPanel.Dock="Left" Text="Status"       SortKey="status"   Width="{StaticResource ColStackStatus}" />
              <c:ColumnHeader DockPanel.Dock="Left" Text="Services"     SortKey="services" Width="{StaticResource ColStackServices}" />
              <c:ColumnHeader DockPanel.Dock="Left" Text="Source"       SortKey="source"   Width="{StaticResource ColStackSource}" />
              <c:ColumnHeader Text="Compose file" SortKey="file" />
            </DockPanel>
          </Border>

          <Panel>
            <ListBox Name="StackList" SelectionMode="Multiple" Background="Transparent"
                     Padding="0"
                     ItemContainerTheme="{StaticResource JbTableRow}">
              <ListBox.ContextMenu>
                <ContextMenu Name="StackMenu">
                  <MenuItem Name="MenuEditStack" Header="Edit" />
                  <MenuItem Name="MenuDeployStack" Header="Deploy" />
                  <MenuItem Name="MenuPullStack" Header="Pull images" />
                  <Separator />
                  <MenuItem Name="MenuStartStack" Header="Start" />
                  <MenuItem Name="MenuStopStack" Header="Stop" />
                  <MenuItem Name="MenuRestartStack" Header="Restart" />
                  <Separator />
                  <MenuItem Name="MenuDownStack" Header="Down" />
                  <MenuItem Name="MenuDeleteStack" Header="Delete" />
                </ContextMenu>
              </ListBox.ContextMenu>
              <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:DockerStackRow">
                  <!-- A stack gets a state dot where a network does not: a stack is a set of
                       containers and so it is doing something, where a network is a fact. It is
                       green only when every container is up, because "running" is the wrong thing
                       to tell somebody whose database container died. -->
                  <StackPanel Classes="cells" Orientation="Horizontal">
                    <DockPanel Width="{StaticResource ColStackName}">
                      <Ellipse DockPanel.Dock="Left" Width="9" Height="9" Margin="0,0,5,0"
                               VerticalAlignment="Center" Fill="{Binding StateBrush}" />
                      <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                    </DockPanel>
                    <!-- Blank where the host could not be asked, which is a different answer from
                         "Not deployed" and is why the row keeps three states rather than a count. -->
                    <TextBlock Text="{Binding Status}"       Width="{StaticResource ColStackStatus}"
                               Opacity="0.75" ToolTip.Tip="{Binding StatusTip}" />
                    <TextBlock Text="{Binding ServiceCount}" Width="{StaticResource ColStackServices}"
                               Opacity="0.75" />
                    <TextBlock Text="{Binding Source}"       Width="{StaticResource ColStackSource}"
                               Opacity="0.75" />
                    <!-- Dimmed further when the file is gone, the way a broken symlink is dimmed in
                         the file explorer: the path is still the truth about where it was. -->
                    <TextBlock Text="{Binding ConfigPath}" Opacity="0.75"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ConfigTip}" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Name="StacksEmptyText" Opacity="0.6" IsVisible="False"
                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Panel>

        </DockPanel>
      </TabItem>

    </TabControl>
  </DockPanel>
</UserControl>
