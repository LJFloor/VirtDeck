<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:VirtDeck.Avalonia.Views"
             x:Class="VirtDeck.Avalonia.Views.StorageDetailsView"
             x:DataType="vm:StorageFact">

  <UserControl.Styles>
    <!-- The Dashboard's fact pair rather than VmDetailsView's DetailSection/DetailRow templates,
         which are declared inside that view and would have to be lifted out for one caller. A
         storage fact is a label and a value and nothing else, so the simpler pair is the right one. -->
    <Style Selector="TextBlock.factlabel">
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="Width" Value="104" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.factvalue">
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <UserControl.DataTemplates>
    <!-- One fact. The tooltip carries the whole value, because a UUID or a mount option list is
         always going to be wider than the cell it is drawn in. -->
    <DataTemplate DataType="vm:StorageFact">
      <StackPanel Orientation="Horizontal" Margin="0,0,0,2" ToolTip.Tip="{Binding Tip}">
        <TextBlock Classes="factlabel" Text="{Binding Label}" />
        <TextBlock Classes="factvalue" Text="{Binding Value}" />
      </StackPanel>
    </DataTemplate>
  </UserControl.DataTemplates>

  <Panel>
    <!-- Two empty states, because they are two different answers: nothing is selected, and several
         things are. VmDetailsView draws the same pair for the same reason. -->
    <TextBlock Name="EmptyText" Opacity="0.6"
               HorizontalAlignment="Center" VerticalAlignment="Center" />

    <DockPanel Name="Body" Margin="12,8,12,10" IsVisible="False">

      <!-- The title line, and the only coloured text in the pane. The name, the dot and the health
           word live here rather than in a fact row for VmDetailsView's reason: a null IBrush is a
           real local value that suppresses the inherited one, so keeping the bound foreground to
           this one line is what leaves every value below visible. -->
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
        <TextBlock DockPanel.Dock="Left" Name="TitleName" FontSize="15" FontWeight="SemiBold"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <Ellipse DockPanel.Dock="Left" Name="TitleDot" Width="9" Height="9" Margin="12,0,5,0"
                 VerticalAlignment="Center" IsVisible="False" />
        <TextBlock DockPanel.Dock="Left" Name="TitleState" VerticalAlignment="Center" />
        <TextBlock Name="TitleNote" Opacity="0.6" Margin="10,0,0,0" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
      </DockPanel>

      <!-- Two columns, split by meaning and not by count: what the device is on the left, what is on
           it and how full it is on the right. A single column would put ten rows in a 200px pane. -->
      <Grid ColumnDefinitions="*,16,*">
        <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl Name="LeftFacts" />
        </ScrollViewer>
        <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl Name="RightFacts" />
        </ScrollViewer>
      </Grid>

    </DockPanel>
  </Panel>
</UserControl>
