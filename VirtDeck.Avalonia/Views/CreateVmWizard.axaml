<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:VirtDeck.Avalonia.Controls"
        xmlns:vm="clr-namespace:VirtDeck.Avalonia.Views"
        x:Class="VirtDeck.Avalonia.Views.CreateVmWizard"
        Title="New Virtual Machine"
        Width="740" Height="600"
        WindowStartupLocation="CenterOwner">

  <Window.Resources>
    <x:Double x:Key="ColLabel">110</x:Double>
  </Window.Resources>

  <DockPanel>

    <!-- Header band: the wizard step title -->
    <Border DockPanel.Dock="Top" Padding="16,11" BorderThickness="0,0,0,1" BorderBrush="#33808080"
            Background="#11808080">
      <TextBlock Name="TitleText" Text="General" FontSize="15" FontWeight="Bold" />
    </Border>

    <!-- Footer band: setup.exe-style button row -->
    <Border DockPanel.Dock="Bottom" Padding="16,12" BorderThickness="0,1,0,0" BorderBrush="#33808080"
            Background="#11808080">
      <DockPanel>
        <Button Name="CancelButton" Content="Cancel" MinWidth="88" IsCancel="True" />
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button Name="BackButton" Content="Back" MinWidth="88" />
          <Button Name="NextButton" Content="Next" MinWidth="88" IsDefault="True" Classes="accent" />
          <Button Name="FinishButton" Content="Finish" MinWidth="88" Classes="accent" IsVisible="False" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Panel Margin="16">

      <!-- Page 1: General -->
      <ScrollViewer Name="GeneralPage">
        <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
              RowSpacing="10" ColumnSpacing="6">

          <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" VerticalAlignment="Center" />
          <TextBox   Grid.Row="0" Grid.Column="1" Name="NameBox" Width="320" HorizontalAlignment="Left" />

          <!-- The media comes before the OS type on purpose: identifying it fills that dropdown in, so
               reading the page top down is also the order the fields depend on each other. -->
          <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="Install media (optional):"
                     Margin="0,10,0,0" />

          <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="24">
            <RadioButton Name="IsoStreamRadio" GroupName="IsoMode" Content="Stream from this PC" IsChecked="True" />
            <RadioButton Name="IsoServerRadio" GroupName="IsoMode" Content="File on server" />
          </StackPanel>

          <!-- Both inputs share the same row; only one is visible at a time. -->
          <c:RemotePathBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Name="IsoPicker" Margin="0,0,0,10" />
          <DockPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Name="LocalIsoRow" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Name="BrowseLocalButton" Content="Browse…" Margin="6,0,0,0" />
            <TextBox Name="LocalIsoBox" IsReadOnly="True" />
          </DockPanel>

          <!-- Directly under the media it depends on: the answer file is only meaningful once the
               media (or the OS dropdown below) says the guest is Windows. -->
          <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
            <Button Name="UnattendButton" Content="Customize Windows setup…" />
            <TextBlock Name="UnattendStatus" Text="not configured" Opacity="0.75" VerticalAlignment="Center" />
          </StackPanel>

          <TextBlock Grid.Row="5" Grid.Column="0" Text="vCPUs:" VerticalAlignment="Center" />
          <NumericUpDown Grid.Row="5" Grid.Column="1" Name="VcpuBox" Width="120" HorizontalAlignment="Left"
                         Minimum="1" Maximum="256" Value="2" Increment="1" FormatString="0" />

          <TextBlock Grid.Row="6" Grid.Column="0" Text="Memory:" VerticalAlignment="Center" />
          <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Spacing="6">
            <NumericUpDown Name="MemBox" Width="150" Minimum="64" Maximum="1048576"
                           Value="4096" Increment="256" FormatString="0" />
            <TextBlock Text="MiB" VerticalAlignment="Center" />
          </StackPanel>

          <TextBlock Grid.Row="7" Grid.Column="0" Text="OS type:" VerticalAlignment="Center" />
          <ComboBox  Grid.Row="7" Grid.Column="1" Name="OsBox" Width="320" HorizontalAlignment="Left" />

          <TextBlock Grid.Row="8" Grid.Column="0" Text="Firmware:" VerticalAlignment="Center" />
          <StackPanel Grid.Row="8" Grid.Column="1" Name="FirmwareRow" Orientation="Horizontal" Spacing="24">
            <RadioButton Name="BiosRadio" GroupName="Firmware" Content="BIOS" IsChecked="True" />
            <RadioButton Name="UefiRadio" GroupName="Firmware" Content="UEFI" />
          </StackPanel>
        </Grid>
      </ScrollViewer>

      <!-- Page 2: Network -->
      <DockPanel Name="NetworkPage" IsVisible="False">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,8">
          <Button Name="AddNicButton" Content="Add…" />
          <Button Name="RemoveNicButton" Content="Remove" />
        </StackPanel>
        <Border BorderThickness="1" BorderBrush="#33808080" CornerRadius="3">
          <DockPanel>
            <Border DockPanel.Dock="Top" Padding="12,3" Background="#11808080">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Model"  Width="120" FontWeight="SemiBold" />
                <TextBlock Text="Type"   Width="120" FontWeight="SemiBold" />
                <TextBlock Text="Source" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
            <ListBox Name="NicList" Background="Transparent"
                     Padding="0" ItemContainerTheme="{StaticResource JbTableRow}">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:NicOpRow">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Model}"  Width="120" />
                    <TextBlock Text="{Binding Type}"   Width="120" />
                    <TextBlock Text="{Binding Source}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>
      </DockPanel>

      <!-- Page 3: Storage -->
      <DockPanel Name="StoragePage" IsVisible="False">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,8">
          <Button Name="AddDiskButton" Content="Add…" />
          <Button Name="EditDiskButton" Content="Edit…" />
          <Button Name="RemoveDiskButton" Content="Remove" />
        </StackPanel>
        <Border BorderThickness="1" BorderBrush="#33808080" CornerRadius="3">
          <DockPanel>
            <Border DockPanel.Dock="Top" Padding="12,3" Background="#11808080">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Target" Width="70"  FontWeight="SemiBold" />
                <TextBlock Text="Kind"   Width="70"  FontWeight="SemiBold" />
                <TextBlock Text="Bus"    Width="70"  FontWeight="SemiBold" />
                <TextBlock Text="Size"   Width="80"  FontWeight="SemiBold" />
                <TextBlock Text="Source" Width="230" FontWeight="SemiBold" />
                <TextBlock Text="Driver" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
            <ListBox Name="DiskList" Background="Transparent"
                     Padding="0" ItemContainerTheme="{StaticResource JbTableRow}">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:DiskOpRow">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Target}" Width="70" />
                    <TextBlock Text="{Binding Kind}"   Width="70" />
                    <TextBlock Text="{Binding Bus}"    Width="70" />
                    <TextBlock Text="{Binding Size}"   Width="80" />
                    <TextBlock Text="{Binding Source}" Width="230" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Driver}" Opacity="0.75" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>
      </DockPanel>

      <!-- Page 4: Summary -->
      <DockPanel Name="SummaryPage" IsVisible="False">
        <CheckBox DockPanel.Dock="Bottom" Name="StartAfterCreateCheck" Margin="0,12,0,0"
                  Content="Start the VM after creation" IsChecked="True" />
        <Border BorderThickness="1" BorderBrush="#33808080" CornerRadius="3">
          <ScrollViewer Padding="12,10">
            <ItemsControl Name="SummaryList">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:SummaryRow">
                  <Grid ColumnDefinitions="140,*" Margin="{Binding RowMargin}">
                    <!-- A header spans both columns; the label/value pair takes one each. Only one
                         of the two shapes is visible per row. -->
                    <TextBlock Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding Value}"
                               FontWeight="SemiBold" IsVisible="{Binding IsHeader}" />
                    <TextBlock Grid.Column="0" Text="{Binding Label}" Opacity="0.75"
                               IsVisible="{Binding !IsHeader}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"
                               IsVisible="{Binding !IsHeader}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
      </DockPanel>

    </Panel>
  </DockPanel>
</Window>
