<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="VirtDeck.Avalonia.Views.HostPowerDialog"
        Title="Restart host"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" CanResize="False" ShowInTaskbar="False">

  <DockPanel Margin="16">

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                HorizontalAlignment="Right" Spacing="8" Margin="0,20,0,0">
      <Button Name="CancelButton" Content="Cancel" MinWidth="88" IsCancel="True" />
      <Button Name="OkButton" Content="Restart" MinWidth="88" IsDefault="True" Classes="accent" />
    </StackPanel>

    <StackPanel Spacing="4">
      <TextBlock Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,12" />

      <TextBlock Text="Delay:" />
      <!-- A dropdown of fixed delays rather than a box to type minutes into: every value here is
           one `shutdown +N` can take, so there is nothing to validate and nothing to reject. -->
      <ComboBox Name="DelayBox" Width="180" HorizontalAlignment="Left" />

      <TextBlock Text="Message to logged in users:" Margin="0,10,0,0" />
      <!-- Broadcast by `shutdown` itself, which is why it is optional and why it is not sent
           separately: the wall goes out with the schedule, and again as the moment approaches. -->
      <TextBox Name="MessageBox" AcceptsReturn="True" Height="64" TextWrapping="Wrap" />
    </StackPanel>
  </DockPanel>
</Window>
