<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="VirtDeck.Avalonia.Views.ReniceDialog"
        Title="Change priority"
        Width="340" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False" ShowInTaskbar="False">
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                Spacing="8" Margin="0,20,0,0">
      <Button Name="CancelButton" Content="Cancel" MinWidth="88" IsCancel="True" />
      <Button Name="OkButton" Content="OK" MinWidth="88" IsDefault="True" Classes="accent" />
    </StackPanel>
    <StackPanel Spacing="10">
      <TextBlock Name="SubjectText" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock Text="Nice value" VerticalAlignment="Center" />
        <NumericUpDown Name="NiceBox" Width="110" Minimum="-20" Maximum="19" Increment="1"
                       FormatString="0" ClipValueToMinMax="True" />
      </StackPanel>
      <TextBlock Text="-20 is the highest priority, 19 the lowest." Opacity="0.6" TextWrapping="Wrap" />
    </StackPanel>
  </DockPanel>
</Window>
