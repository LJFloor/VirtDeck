<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VirtDeck.Avalonia.Views"
        x:Class="VirtDeck.Avalonia.Views.DeleteVmDialog"
        x:DataType="vm:DeletableDiskRow"
        Title="Delete VM"
        Width="560" Height="380"
        WindowStartupLocation="CenterOwner">

  <DockPanel Margin="16">

    <TextBlock DockPanel.Dock="Top" Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,14" />

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
      <Button Name="CancelButton" Content="Cancel" MinWidth="88" IsCancel="True" />
      <Button Name="OkButton" Content="Delete" MinWidth="88" IsDefault="True" Classes="accent" />
    </StackPanel>

    <TextBlock DockPanel.Dock="Top" Name="DisksLabel" Margin="0,0,0,6"
               Text="Also delete these disk images:" />

    <Border BorderThickness="1" BorderBrush="#33808080" CornerRadius="3" Name="DisksBorder">
      <ScrollViewer>
        <!-- An ItemsControl of CheckBoxes, not a ListBox: the checked state is the selection here,
             so a separate row-highlight would just be a second, confusing selection model. -->
        <ItemsControl Name="DiskList" Margin="8">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:DeletableDiskRow">
              <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Content="{Binding Label}" Margin="0,2" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>
  </DockPanel>
</Window>
