<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:VirtDeck.Avalonia.Views"
             x:Class="VirtDeck.Avalonia.Views.LogsModule">

  <UserControl.Resources>
    <!-- One column layout shared by every row template, so the three kinds of row line up with
         each other. There is no heading strip to line them up with: the list is chronological and
         a heading offering an order it will not honour is worse than no heading at all. -->
    <x:Double x:Key="ColGlyph">16</x:Double>
    <x:Double x:Key="ColTime">86</x:Double>

    <!-- A warning triangle with a bang in it, in the house style: a 16x16 box, stroked not filled.
         One glyph for both severities, coloured by the row, because what separates an error from a
         warning here is how loud it is and not what shape it is. -->
    <StreamGeometry x:Key="IconSeverity">M8,2.2 L15,14 H1 Z M8,6.2 V9.8 M8,11.4 V12.2</StreamGeometry>
  </UserControl.Resources>

  <DockPanel>

    <!-- The toolbar is Cockpit's, minus its Filters box. Every control on it changes what the host
         is asked rather than narrowing the listing in hand, which is the one place this module
         departs from every other table in the app: the journal is a query, not a table that was
         read once. Nothing here is accented, since this module creates nothing. -->
    <Border DockPanel.Dock="Top" Padding="8" BorderThickness="0,0,0,1" BorderBrush="#22808080">
      <DockPanel>
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="6">
          <ComboBox Name="RangeBox" Width="235" VerticalAlignment="Center"
                    ToolTip.Tip="Which slice of the journal to read. The boots below the four fixed ranges are what `journalctl --list-boots` found, newest first." />
          <TextBlock Text="Priority" VerticalAlignment="Center" Margin="6,0,0,0" />
          <ComboBox Name="PriorityBox" Width="160" VerticalAlignment="Center"
                    ToolTip.Tip="syslog severity, read as this level and everything above it." />
          <TextBlock Text="Identifier" VerticalAlignment="Center" Margin="6,0,0,0" />
          <ComboBox Name="IdentifierBox" Width="190" VerticalAlignment="Center"
                    ToolTip.Tip="One program's entries, matched on SYSLOG_IDENTIFIER by the host. The list is what has been seen so far." />
        </StackPanel>

        <!-- Pause holds the list still. It is not a stop: resuming reads from the newest entry in
             hand, so what happened while paused arrives rather than being lost. -->
        <Button Name="PauseButton" DockPanel.Dock="Right" Content="Pause" MinWidth="78"
                ToolTip.Tip="Stop the live feed. Nothing is lost: resuming picks up from the newest entry on screen." />
        <Panel />
      </DockPanel>
    </Border>

    <!-- Only while a page is in the air, so the list never looks like it has simply ended when it
         has not. It is a strip of its own rather than an overlay because it is about the bottom of
         the list, which is where the next page goes. -->
    <Border Name="PagingStrip" DockPanel.Dock="Bottom" Padding="12,3" Background="#11808080"
            BorderThickness="0,1,0,0" BorderBrush="#22808080" IsVisible="False">
      <TextBlock Name="PagingText" Opacity="0.6" Text="Reading..." />
    </Border>

    <Panel>
      <ListBox Name="EntryList" SelectionMode="Single" Background="Transparent" Padding="0"
               ItemContainerTheme="{StaticResource JbTableRow}">
        <ListBox.DataTemplates>

          <DataTemplate DataType="vm:LogRow">
            <DockPanel Classes="cells">
              <Panel DockPanel.Dock="Left" Width="{StaticResource ColGlyph}" VerticalAlignment="Center">
                <Path Data="{StaticResource IconSeverity}" Width="13" Height="13"
                      Stretch="Uniform" StrokeThickness="1.2" StrokeJoin="Round"
                      Stroke="{Binding SeverityBrush}" IsVisible="{Binding HasSeverity}"
                      ToolTip.Tip="{Binding SeverityText}" />
              </Panel>
              <TextBlock DockPanel.Dock="Left" Text="{Binding Time}" Width="{StaticResource ColTime}"
                         Opacity="0.7" VerticalAlignment="Center" />
              <!-- The identifier is docked right, so it is as wide as its own text and every row
                   ends flush with the one above it, which is what makes a column of program names
                   readable down the side of messages of every length. -->
              <TextBlock DockPanel.Dock="Right" Text="{Binding Identifier}" Opacity="0.6"
                         VerticalAlignment="Center" TextAlignment="Right" />
              <TextBlock Text="{Binding Message}" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Tip}" />
            </DockPanel>
          </DataTemplate>

          <DataTemplate DataType="vm:LogDayRow">
            <TextBlock Text="{Binding Text}" FontWeight="SemiBold" Margin="0,10,0,2" />
          </DataTemplate>

          <DataTemplate DataType="vm:LogRebootRow">
            <!-- Indented to the message column, where the mock puts it: the marker is about what
                 the entries say and not about when one of them was logged. -->
            <TextBlock Text="{Binding Text}" FontStyle="Italic" Opacity="0.6" Margin="108,3,0,3" />
          </DataTemplate>

        </ListBox.DataTemplates>
      </ListBox>

      <!-- Why the list is empty, so a module with nothing to show never just looks broken. -->
      <TextBlock Name="EmptyText" Opacity="0.6" IsVisible="False"
                 TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"
                 HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Panel>

  </DockPanel>
</UserControl>
