<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="VirtDeck.Avalonia.Views.AddNicDialog"
        Title="Add Network Adapter"
        Width="450" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" CanResize="False">

  <DockPanel Margin="16">

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                HorizontalAlignment="Right" Spacing="8" Margin="0,20,0,0">
      <Button Name="CancelButton" Content="Cancel" MinWidth="88" IsCancel="True" />
      <Button Name="OkButton" Content="OK" MinWidth="88" IsDefault="True" Classes="accent" />
    </StackPanel>

    <Grid ColumnDefinitions="150,*">
      <StackPanel Grid.Column="0" Spacing="10" Margin="0,4,12,0">
        <RadioButton Name="BridgeRadio" GroupName="Kind" Content="Bridge" IsChecked="True" />
        <RadioButton Name="NetworkRadio" GroupName="Kind" Content="Virtual network" />
      </StackPanel>

      <StackPanel Grid.Column="1" Spacing="4">
        <TextBlock Text="Source:" />
        <!-- AutoCompleteBox, not ComboBox: the WinForms original was an editable combo, so a
             bridge or network the host didn't report can still be typed in by hand. -->
        <AutoCompleteBox Name="SourceBox" HorizontalAlignment="Stretch"
                         FilterMode="ContainsOrdinal" MinimumPrefixLength="0" />

        <TextBlock Text="Model:" Margin="0,8,0,0" />
        <ComboBox Name="ModelBox" Width="160" HorizontalAlignment="Left" />
      </StackPanel>
    </Grid>
  </DockPanel>
</Window>
