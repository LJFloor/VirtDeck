<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:VirtDeck.Services;assembly=VirtDeck.Core"
        x:Class="VirtDeck.Avalonia.Views.LoginWindow"
        Title="VirtDeck - Connect"
        Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" CanResize="False">
  <StackPanel Margin="24" Spacing="6">
    <TextBlock Text="Connect to a libvirt host over SSH" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />

    <Grid ColumnDefinitions="*,8,70">
      <TextBlock Grid.Column="0" Text="Host" />
      <TextBlock Grid.Column="2" Text="Port" />
    </Grid>
    <Grid ColumnDefinitions="*,8,70">
      <TextBox Grid.Column="0" Name="HostBox" PlaceholderText="hostname or IP" />
      <TextBox Grid.Column="2" Name="PortBox" Text="22" />
    </Grid>

    <TextBlock Text="Username" Margin="0,8,0,0" />
    <TextBox Name="UserBox" />

    <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,12,0,0">
      <RadioButton Name="PasswordAuthRadio" GroupName="Auth" Content="Password" IsChecked="True" />
      <RadioButton Name="KeyAuthRadio" GroupName="Auth" Content="SSH key" />
    </StackPanel>

    <!-- Password auth: one secret, used for the login and for sudo. -->
    <StackPanel Name="PasswordPanel" Spacing="6">
      <TextBlock Text="Password" Margin="0,4,0,0" />
      <TextBox Name="PasswordBox" PasswordChar="•" />
    </StackPanel>

    <!-- Key auth: the key authenticates SSH, the sudo password is a separate secret. -->
    <StackPanel Name="KeyPanel" Spacing="6" IsVisible="False">
      <TextBlock Name="KeyLabel" Text="Private key" Margin="0,4,0,0" />
      <Grid ColumnDefinitions="*,6,Auto">
        <ComboBox Grid.Column="0" Name="KeyCombo" HorizontalAlignment="Stretch">
          <ComboBox.ItemTemplate>
            <DataTemplate DataType="svc:SshKeyCandidate">
              <TextBlock Text="{Binding DisplayName}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Grid.Column="2" Name="BrowseKeyButton" Content="…" MinWidth="30" ToolTip.Tip="Browse for a private key" />
      </Grid>

      <StackPanel Name="PassphrasePanel" Spacing="6" IsVisible="False">
        <TextBlock Text="Passphrase" Margin="0,8,0,0" />
        <TextBox Name="PassphraseBox" PasswordChar="•" />
      </StackPanel>

      <TextBlock Text="Sudo password" Margin="0,8,0,0" />
      <TextBox Name="SudoPasswordBox" PasswordChar="•" />
      <TextBlock Text="Leave blank if sudo needs no password on this host."
                 TextWrapping="Wrap" Opacity="0.7" />
    </StackPanel>

    <TextBlock Name="StatusText" TextWrapping="Wrap" Margin="0,12,0,0" />

    <Button Name="ConnectButton" Content="Connect" IsDefault="True"
            HorizontalAlignment="Right" MinWidth="110" Margin="0,12,0,0" Classes="accent" />
  </StackPanel>
</Window>
