<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:VirtDeck.Avalonia.Views.Storage"
        x:Class="VirtDeck.Avalonia.Views.Storage.DiskDetailsWindow"
        Title="Disk"
        Width="960" Height="620" MinWidth="720" MinHeight="460"
        WindowStartupLocation="CenterOwner">

  <!-- Declared here rather than in each page, so no two of them can drift apart on what a
       fact looks like. Styles and data templates on a Window reach its whole tree, tab content
       included. The pair is the Dashboard's; a storage fact is a label and a value and needs no
       section heading, which is why VmDetailsView's DetailSection/DetailRow are not used. -->
  <Window.Styles>
    <Style Selector="TextBlock.factlabel">
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="Width" Value="112" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.factvalue">
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Styles>

  <Window.DataTemplates>
    <DataTemplate DataType="s:DiskFact">
      <StackPanel Orientation="Horizontal" Margin="0,0,0,3" ToolTip.Tip="{Binding Tip}">
        <TextBlock Classes="factlabel" Text="{Binding Label}" />
        <TextBlock Classes="factvalue" Text="{Binding Value}" />
      </StackPanel>
    </DataTemplate>
  </Window.DataTemplates>

  <DockPanel>

    <!-- Refresh and Close, and a status line to their left for what the deeper read is doing. No
         Cancel: nothing here writes, so there is no work in flight worth interrupting and the
         window closing is the whole of how you stop looking. -->
    <Border DockPanel.Dock="Bottom" Padding="16,12"
            BorderThickness="0,1,0,0" BorderBrush="#33808080" Background="#11808080">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Name="StatusText" Grid.Column="0" Opacity="0.7"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                   Margin="0,0,12,0" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Name="RefreshButton" Content="Refresh" MinWidth="88" />
          <Button Name="CloseButton" Content="Close" IsCancel="True" MinWidth="88" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Top-placed tabs rather than JbSideTabControl. The container editor and the answer-file
         window use the side rail because they have five and seventeen pages; two short names do not
         earn a 160px column of their own, and VmEditWindow is the precedent for a read-only tabbed
         window with a bare TabControl picking up the theme's top-placed pair.

         **Two pages, because there are two questions and not three.** What the disk is and what is
         stacked on it are one subject read together, so the partition table is a group box on the
         General page rather than a tab beside it; what SMART says is the other, and it is the half
         that is a separate round trip, can be refused, and can ask to wake a parked drive. -->
    <TabControl Name="SectionTabs">
      <TabItem Header="General">
        <s:DiskGeneralTab />
      </TabItem>
      <TabItem Header="Health">
        <s:DiskHealthTab />
      </TabItem>
    </TabControl>

  </DockPanel>
</Window>
