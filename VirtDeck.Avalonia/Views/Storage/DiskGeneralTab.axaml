<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:VirtDeck.Avalonia.Views.Storage"
             x:Class="VirtDeck.Avalonia.Views.Storage.DiskGeneralTab">

  <DockPanel Margin="16,14,16,14">

    <!-- The name, the verdict and the device node. TitleState is the only bound Foreground on this
         page, and deliberately: a null IBrush is a real local value that suppresses the inherited
         one rather than falling back to it, so keeping the binding to this one line is what leaves
         every value below it visible. -->
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
      <TextBlock Name="TitleName" DockPanel.Dock="Left" FontSize="15" FontWeight="SemiBold"
                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      <Ellipse Name="TitleDot" DockPanel.Dock="Left" Width="9" Height="9"
               Margin="12,0,5,0" VerticalAlignment="Center" />
      <TextBlock Name="TitleState" DockPanel.Dock="Left" VerticalAlignment="Center" />
      <TextBlock Name="TitleNote" Opacity="0.6" Margin="10,0,0,0"
                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
    </DockPanel>

    <!-- Two columns split by meaning and not by count: what the device is on the left, what is on it
         and how it is doing on the right. -->
    <Grid ColumnDefinitions="*,24,*">
      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
        <ItemsControl Name="LeftFacts" />
      </ScrollViewer>
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
        <ItemsControl Name="RightFacts" />
      </ScrollViewer>
    </Grid>

  </DockPanel>
</UserControl>
