<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:VirtDeck.Avalonia.Controls"
        x:Class="VirtDeck.Avalonia.Views.Cron.CronRunWindow"
        Title="Run now"
        Width="900" Height="520" MinWidth="480" MinHeight="300">

  <DockPanel>

    <Border DockPanel.Dock="Bottom" Padding="16,12" BorderThickness="0,1,0,0" BorderBrush="#33808080"
            Background="#11808080">
      <DockPanel>
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8">
          <!-- No IsCancel and no IsDefault: Escape and Enter belong to the job, exactly as they
               belong to the container in ContainerConsoleWindow. -->
          <Button Name="StopButton" Content="Stop" MinWidth="72" />
          <Button Name="CloseButton" Content="Close" MinWidth="72" />
        </StackPanel>
        <TextBlock Name="StatusText" Margin="12,0,0,0"
                   VerticalAlignment="Center" Opacity="0.75" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <ScrollBar Name="Scroll" DockPanel.Dock="Right" Orientation="Vertical"
               Visibility="Visible" AllowAutoHide="False" Minimum="0" SmallChange="1" />

    <c:TerminalControl Name="Terminal" />

  </DockPanel>
</Window>
