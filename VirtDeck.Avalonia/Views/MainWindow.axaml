<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="VirtDeck.Avalonia.Views.MainWindow"
        Title="VirtDeck"
        Width="1080" Height="640"
        WindowStartupLocation="CenterScreen">

  <!-- No content here on purpose. What this window holds is a ShellView, one per host, and it is
       assigned in code because switching host swaps it for another: see MainWindow.Replace. -->

</Window>
