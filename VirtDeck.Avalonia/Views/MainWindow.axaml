<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VirtDeck.Avalonia.Views"
        x:Class="VirtDeck.Avalonia.Views.MainWindow"
        Title="VirtDeck"
        Width="1080" Height="640"
        WindowStartupLocation="CenterScreen">

  <Window.Resources>
    <!-- Module glyphs. All vector art in this app is inline Path data in the house style: a 16x16
         box, stroked not filled, so it reads at one weight beside a 12pt label. -->
    <StreamGeometry x:Key="IconVirtualMachines">M1,2 H15 V11 H1 Z M6,14 H10 M8,11 V14</StreamGeometry>
    <StreamGeometry x:Key="IconContainers">M1,4 H15 V13 H1 Z M1,4 L3.5,1 H12.5 L15,4 M6,4 V13 M10,4 V13</StreamGeometry>
    <StreamGeometry x:Key="IconFileExplorer">M1,3 H6 L7.5,5 H15 V13 H1 Z</StreamGeometry>
    <StreamGeometry x:Key="IconTerminal">M1,3 H15 V13 H1 Z M4,6.5 L6.5,8.5 L4,10.5 M8,10.5 H12</StreamGeometry>
  </Window.Resources>

  <DockPanel>

    <Border DockPanel.Dock="Bottom" Padding="10,5" BorderThickness="0,1,0,0" BorderBrush="#22808080">
      <DockPanel>
        <TextBlock Name="HostCapsText" DockPanel.Dock="Right" Opacity="0.7" />
        <Border DockPanel.Dock="Right" Width="1" Margin="10,1" Background="#33808080" />
        <TextBlock Name="ThroughputText" DockPanel.Dock="Right" Opacity="0.7"
                   ToolTip.Tip="Combined SSH tunnel throughput: management channel, file transfers, SPICE consoles and NBD media streams" />
        <TextBlock Name="StatusText" />
      </DockPanel>
    </Border>

    <!-- The side menu. The shell does not name its modules: it walks these items and talks to
         whichever content implements IModule, so a new module is a TabItem here and nothing else. -->
    <TabControl Name="Modules" Theme="{StaticResource JbModuleTabControl}">

      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Path Data="{StaticResource IconVirtualMachines}" Width="16" Height="16"
                  Stroke="{DynamicResource JbButtonForeground}" StrokeThickness="1.2"
                  VerticalAlignment="Center" />
            <TextBlock Text="Virtual machines" VerticalAlignment="Center" />
          </StackPanel>
        </TabItem.Header>
        <vm:VirtualMachinesModule />
      </TabItem>

      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Path Data="{StaticResource IconContainers}" Width="16" Height="16"
                  Stroke="{DynamicResource JbButtonForeground}" StrokeThickness="1.2"
                  VerticalAlignment="Center" />
            <TextBlock Text="Containers" VerticalAlignment="Center" />
          </StackPanel>
        </TabItem.Header>
        <vm:ContainersModule />
      </TabItem>

      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Path Data="{StaticResource IconFileExplorer}" Width="16" Height="16"
                  Stroke="{DynamicResource JbButtonForeground}" StrokeThickness="1.2"
                  VerticalAlignment="Center" />
            <TextBlock Text="File explorer" VerticalAlignment="Center" />
          </StackPanel>
        </TabItem.Header>
        <vm:FileExplorerModule />
      </TabItem>

      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Path Data="{StaticResource IconTerminal}" Width="16" Height="16"
                  Stroke="{DynamicResource JbButtonForeground}" StrokeThickness="1.2"
                  VerticalAlignment="Center" />
            <TextBlock Text="Terminal" VerticalAlignment="Center" />
          </StackPanel>
        </TabItem.Header>
        <vm:TerminalModule />
      </TabItem>

    </TabControl>
  </DockPanel>
</Window>
