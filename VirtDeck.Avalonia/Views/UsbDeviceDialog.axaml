<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VirtDeck.Avalonia.Views"
        x:Class="VirtDeck.Avalonia.Views.UsbDeviceDialog"
        x:DataType="vm:UsbDeviceRow"
        Title="USB Devices"
        Width="620" Height="400"
        WindowStartupLocation="CenterOwner">

  <Window.Resources>
    <x:Double x:Key="ColStatus">90</x:Double>
  </Window.Resources>

  <DockPanel Margin="12">

    <Border DockPanel.Dock="Top" Padding="10,6" Margin="0,0,0,10" Background="#22d68f00">
      <TextBlock TextWrapping="Wrap"
                 Text="USB redirection is experimental. Webcams and audio devices may not work." />
    </Border>

    <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <Button Name="CloseButton" DockPanel.Dock="Right" Content="Close" MinWidth="88" IsCancel="True" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Name="RedirectButton" Content="Redirect" MinWidth="88"
                ToolTip.Tip="Hand the selected device to the VM. It leaves this PC until released." />
        <Button Name="ReleaseButton" Content="Release" MinWidth="88"
                ToolTip.Tip="Give the device back to this PC." />
        <Button Name="RefreshButton" Content="Refresh" MinWidth="88" />
      </StackPanel>
    </DockPanel>

    <!-- Slot usage, or why redirection is off. Two lines' worth of room so a setup hint fits. -->
    <TextBlock DockPanel.Dock="Bottom" Name="StatusText" Margin="0,10,0,0"
               MinHeight="32" TextWrapping="Wrap" Opacity="0.85" />

    <Border DockPanel.Dock="Top" Padding="10,5" Background="#11808080">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Text="Status" Width="{StaticResource ColStatus}" FontWeight="SemiBold" />
        <TextBlock Text="Device" FontWeight="SemiBold" />
      </DockPanel>
    </Border>

    <Panel>
      <ListBox Name="DeviceList" Background="Transparent">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="vm:UsbDeviceRow">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Width="{StaticResource ColStatus}"
                         Foreground="{Binding StatusBrush}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <TextBlock Name="EmptyText" Text="(no redirectable USB devices found)"
                 IsVisible="False" Opacity="0.6" Margin="10,8"
                 HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" />
    </Panel>

  </DockPanel>
</Window>
