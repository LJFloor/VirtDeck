<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="VirtDeck.Avalonia.Views.Printing.PrinterEditWindow"
        Title="Edit printer"
        Width="560" SizeToContent="Height" MinWidth="480"
        WindowStartupLocation="CenterOwner">

  <DockPanel>

    <Border DockPanel.Dock="Bottom" Padding="16,12" BorderThickness="0,1,0,0" BorderBrush="#33808080"
            Background="#11808080">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Name="StatusText" Margin="0,0,12,0"
                   VerticalAlignment="Center" Opacity="0.75" TextTrimming="CharacterEllipsis" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Name="CancelButton" Content="Cancel" MinWidth="88" IsCancel="True" />
          <Button Name="SaveButton" Content="Save" MinWidth="88" IsDefault="True" Classes="accent" />
        </StackPanel>
      </Grid>
    </Border>

    <StackPanel Classes="page" Spacing="18" Margin="16">

      <HeaderedContentControl Theme="{StaticResource JbGroupBox}" Header="Printer">
        <StackPanel Classes="options">
          <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" VerticalAlignment="Center" />
            <!-- Disabled rather than hidden, with the reason on the wrapping Border, because the
                 name is the queue: CUPS has no rename. -->
            <Border Grid.Row="0" Grid.Column="1" Background="Transparent"
                    ToolTip.Tip="CUPS has no rename. To change the name, add a printer and delete this one.">
              <TextBox Name="NameBox" IsEnabled="False" />
            </Border>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Description" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="1" Name="DescriptionBox" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Location" VerticalAlignment="Center" />
            <TextBox Grid.Row="2" Grid.Column="1" Name="LocationBox" />
          </Grid>
        </StackPanel>
      </HeaderedContentControl>

      <!-- Only for a queue on the cups-pdf backend. -->
      <HeaderedContentControl Name="PdfGroup" Theme="{StaticResource JbGroupBox}" Header="PDF"
                              IsVisible="False">
        <StackPanel Classes="options">
          <Grid ColumnDefinitions="110,*">
            <TextBlock Grid.Column="0" Text="Files land in" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Name="PdfFolderBox" />
          </Grid>
          <TextBlock Name="PdfFolderNote" Classes="subnote" TextWrapping="Wrap" IsVisible="False" />
        </StackPanel>
      </HeaderedContentControl>

    </StackPanel>

  </DockPanel>
</Window>
