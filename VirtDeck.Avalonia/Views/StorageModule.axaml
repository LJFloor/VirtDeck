<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:VirtDeck.Avalonia.Views"
             xmlns:c="clr-namespace:VirtDeck.Avalonia.Controls"
             x:Class="VirtDeck.Avalonia.Views.StorageModule"
             x:DataType="vm:StorageRow">

  <UserControl.Resources>
    <!-- One column layout shared by the heading strip and every row, so they stay aligned. -->
    <x:Double x:Key="ColDevice">280</x:Double>
    <x:Double x:Key="ColKind">110</x:Double>
    <x:Double x:Key="ColSize">100</x:Double>

    <!-- The four SMART columns, which are drawn only where a disk on this host answered for them.
         They are kept narrow on purpose: three of them are on screen at once on a typical host, and
         Health is the fill column that absorbs what is left, so every pixel taken here comes out of
         the one cell that has a sentence to fit. -->
    <x:Double x:Key="ColTemp">70</x:Double>
    <x:Double x:Key="ColPowerOn">100</x:Double>
    <x:Double x:Key="ColWear">70</x:Double>
    <x:Double x:Key="ColRealloc">100</x:Double>

    <!-- The ZFS tree's own layout. The name column is the widest in the app's tables because it is
         the only one that holds art before its text: an indent of 16 per level, a 16px chevron and
         the 14px state dot slot all come out of it before a name starts. -->
    <x:Double x:Key="ColNode">300</x:Double>
    <x:Double x:Key="ColNodeType">90</x:Double>
    <x:Double x:Key="ColNodeUsed">90</x:Double>
    <x:Double x:Key="ColNodeAvail">90</x:Double>
    <x:Double x:Key="ColNodeRefer">90</x:Double>
    <x:Double x:Key="ColNodeCompress">90</x:Double>

    <StreamGeometry x:Key="IconRefresh">M13,8 A5,5 0 1 1 11.54,4.46 L13,5.78 M13,3 V5.78 H10.22</StreamGeometry>
  </UserControl.Resources>

  <!-- **Two subjects on one host, not two views of one fact**, which is what ContainersModule's
       four tabs are and what ServicesModule's two are. The disks are the hardware; a pool is a
       thing built out of that hardware, with its own toolbar, its own empty states and its own
       round trip. Each page carries its own toolbar rather than sharing one at the top, because a
       toolbar shows only what applies to the table under it and the ZFS page has a command that
       creates something where the disks page has none. -->
  <TabControl Name="Tabs">

    <TabItem Header="Disks">
      <DockPanel>

    <!-- A Refresh button and nothing else. Nothing on a host announces a disk being plugged in that
         VirtDeck can hear without root and a udev tail, and a device layout changes about as often
         as an account does, so this is the User accounts answer rather than the services one. No
         command here creates anything, so nothing carries Classes="accent". -->
    <Border DockPanel.Dock="Top" Padding="8" BorderThickness="0,0,0,1" BorderBrush="#22808080">
      <DockPanel>
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="6">
          <!-- A disabled control is not hit-testable, so the tooltip hangs off an enabled parent
               and reads the reason the code-behind wrote into the button's Tag. -->
          <Border Background="Transparent" ToolTip.Tip="{Binding #RefreshButton.Tag}">
            <Button Name="RefreshButton" Theme="{StaticResource JbIconButton}">
              <Path Data="{StaticResource IconRefresh}" Width="16" Height="16"
                    Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.2" />
            </Button>
          </Border>
        </StackPanel>
        <Panel />
      </DockPanel>
    </Border>

    <!-- **Every column here sorts, and that is new.** Three of them used not to: Filesystem,
         Mounted at and Used only ever described a partition or a volume, and a sort on them would
         have reordered the disks by a fact about something stacked on one. Those three are gone with
         the tree, so what is left is eight columns that are each about a whole disk and each carry
         an order. TableSort still skips a cell with an empty SortKey; the storage table is simply no
         longer the table that needed it, and the partition table in the details window is where a
         sort would now turn a stack into a pile.

         **The four SMART columns are drawn only where a disk on this host answered for them**, which
         is the absent-tooling rule applied to a column rather than to a page: a column of blanks is
         not an answer, and which of these a host can fill in is a fact about its drives rather than
         about VirtDeck. Life left is NVMe's and Reallocated is ATA's, so a single-technology host draws
         one or the other and never both. The verdict stays last and stays the fill column, so the
         numbers behind it read left to right into it and what is left over goes to the one cell with
         a sentence in it. Their visibility is the module's to set; see SmartColumns.

         Indent clears the state dot's slot (14) so the heading sits over the name rather than over
         the art in front of it. It was 30 while a chevron stood there too. -->
    <Border DockPanel.Dock="Top" Padding="12,3" Background="#11808080"
            BorderThickness="0,0,0,1" BorderBrush="#22808080">
      <DockPanel Name="DeviceHeaderStrip">
        <c:ColumnHeader DockPanel.Dock="Left" Text="Device" SortKey="device" Indent="14"
                        Width="{StaticResource ColDevice}" />
        <c:ColumnHeader DockPanel.Dock="Left" Text="Kind" SortKey="kind"
                        Width="{StaticResource ColKind}"
                        Tip="What the drive is. SSD or HDD, because that it is a disk is already said by it being in this table." />
        <c:ColumnHeader DockPanel.Dock="Left" Text="Size" SortKey="size"
                        Width="{StaticResource ColSize}" />
        <c:ColumnHeader Name="TempHeader" DockPanel.Dock="Left" Text="Temp" SortKey="temp"
                        Width="{StaticResource ColTemp}"
                        Tip="What the drive's own temperature sensor reads. Empty for a disk that has none to report." />
        <c:ColumnHeader Name="PowerOnHeader" DockPanel.Dock="Left" Text="Powered on" SortKey="poweron"
                        Width="{StaticResource ColPowerOn}"
                        Tip="How long the drive has been powered on in total, as SMART has counted it. Sorting puts the oldest drive on the host at one end." />
        <c:ColumnHeader Name="WearHeader" DockPanel.Dock="Left" Text="Life left" SortKey="wear"
                        Width="{StaticResource ColWear}"
                        Tip="How much of its rated write endurance an NVMe drive has left. It is the drive's own percentage-used figure flipped, so it reads the same way round as everything else here: higher is better. 100% is the manufacturer's rating rather than a cliff, and a drive at 0% left usually goes on working." />
        <c:ColumnHeader Name="ReallocHeader" DockPanel.Dock="Left" Text="Reallocated" SortKey="realloc"
                        Width="{StaticResource ColRealloc}"
                        Tip="Sectors the drive has already remapped to its spares. Zero is the healthy reading; a count that climbs between visits is the classic sign of a disk on its way out." />
        <c:ColumnHeader Text="Health" SortKey="health"
                        Tip="What the drive's own SMART reports. Sorting puts the disks worth looking at first." />
      </DockPanel>
    </Border>

    <Panel>
      <!-- Multiple, so Copy device path can take several at once. Disk details is a single-selection
           command and says so by being disabled on anything else: one window per disk is the point
           of it, and opening five at once from one keystroke is not what anybody meant. -->
      <ListBox Name="DeviceList" SelectionMode="Multiple" Background="Transparent" Padding="0"
               ItemContainerTheme="{StaticResource JbTableRow}">
        <ListBox.ContextMenu>
          <ContextMenu Name="DeviceMenu">
            <MenuItem Name="MenuDetails" Header="Disk details" />
            <MenuItem Name="MenuCopyPath" Header="Copy device path" />
          </ContextMenu>
        </ListBox.ContextMenu>
        <ListBox.ItemTemplate>
          <DataTemplate DataType="vm:StorageRow">

            <!-- **A DockPanel and not a horizontal StackPanel, which is a fix and not a style
                 preference.** The heading strip above is a DockPanel whose last child fills, so
                 Health is its fill column; the row was a StackPanel, which measures its children
                 with infinite width, so the Health cell's TextTrimming never fired and a long
                 verdict ran off the right-hand edge of the row while the heading above it had been
                 squeezed to nothing. Docking every cell Left and leaving Health as the fill child is
                 what makes the row and the strip the same layout.

                 The .cells gutter style has a DockPanel arm with no :not(:nth-child(1)) guard, which
                 is right here for the reason it is right in the file explorer: the first cell is a
                 DockPanel rather than a TextBlock, so the rule does not reach it and every TextBlock
                 it does reach genuinely is a column that wants the 6px. -->
            <DockPanel Classes="cells" ToolTip.Tip="{Binding Summary}">

              <DockPanel DockPanel.Dock="Left" Width="{StaticResource ColDevice}">
                <!-- The dot's slot is kept at its width whatever the dot is doing, so every name in
                     the column starts at the same place. A Border with a width rather than a margin,
                     so the row's hover paints it along with everything else instead of leaving a
                     dead strip down the left. -->
                <Panel DockPanel.Dock="Left" Width="14">
                  <Ellipse Width="9" Height="9" HorizontalAlignment="Left" VerticalAlignment="Center"
                           Fill="{Binding StateBrush}" ToolTip.Tip="{Binding HealthTip}" />
                </Panel>

                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
              </DockPanel>

              <TextBlock DockPanel.Dock="Left" Text="{Binding TypeText}"
                         Width="{StaticResource ColKind}" VerticalAlignment="Center" />
              <TextBlock DockPanel.Dock="Left" Text="{Binding SizeText}"
                         Width="{StaticResource ColSize}" VerticalAlignment="Center" />

              <!-- The SMART numbers. Every one is blank on a disk that did not report it, and the
                   column itself is gone when no disk on the host did; the flags are table-wide and
                   set from the listing, never per row. -->
              <TextBlock DockPanel.Dock="Left" Text="{Binding TemperatureText}"
                         Width="{StaticResource ColTemp}" VerticalAlignment="Center"
                         IsVisible="{Binding ShowTemperature}" />
              <TextBlock DockPanel.Dock="Left" Text="{Binding PowerOnText}"
                         Width="{StaticResource ColPowerOn}" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis"
                         IsVisible="{Binding ShowPowerOn}" ToolTip.Tip="{Binding PowerOnTip}" />
              <TextBlock DockPanel.Dock="Left" Text="{Binding LifeText}"
                         Width="{StaticResource ColWear}" VerticalAlignment="Center"
                         IsVisible="{Binding ShowWear}" ToolTip.Tip="{Binding LifeTip}" />
              <TextBlock DockPanel.Dock="Left" Text="{Binding ReallocText}"
                         Width="{StaticResource ColRealloc}" VerticalAlignment="Center"
                         IsVisible="{Binding ShowReallocated}" ToolTip.Tip="{Binding ReallocTip}" />

              <TextBlock Text="{Binding HealthText}" Foreground="{Binding HealthBrush}"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                         ToolTip.Tip="{Binding HealthTip}" />
            </DockPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- Why the table is empty, so a host with no lsblk, a listing that failed, a host with
           genuinely nothing on it and a host whose block devices are all loop devices never look
           the same. -->
      <TextBlock Name="DeviceEmpty" Opacity="0.6" IsVisible="False"
                 TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"
                 HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Panel>

      </DockPanel>
    </TabItem>

    <!-- **Disabled whole rather than command by command when the host has no ZFS**, which is the
         one page-level shape ContainersModule's Stacks tab already establishes: without zpool not
         one command on this page can run, so an enabled page would be a table of nothing over
         buttons that all refuse. ToolTip.ShowOnDisabled is what lets it still say why, and it is
         the exception to the enabled-parent-Border rule the rest of the app follows, because a
         TabItem has no parent of its own to hang a tooltip off.

         The module itself stays on screen either way: `zpool` is deliberately not in RequiredTools,
         for the reason smartctl is not, that naming a tool one part of a page needs takes the whole
         page away over it. -->
    <TabItem Header="ZFS" Name="ZfsTab" ToolTip.ShowOnDisabled="True">
      <DockPanel>

        <!-- Refresh, then the two commands that need no selection, then the search box at the far
             right where every module puts it. New pool is accented because it is the one command on
             this page that brings a pool into being; New dataset sits beside it rather than only on
             the right-click menu because it is the command somebody comes to this page to run, and
             Import is here because it is the one whose subject is not in the tree yet. Everything
             else acts on a row and lives on the menu.

             **A search box, which the pools table did not earn and the tree does.** A handful of
             pools is the size at which libvirt networks and docker networks are told to go without
             one; a host with a dataset per VM, per share and per backup target is the size at which
             the services and users tables have theirs. -->
        <Border DockPanel.Dock="Top" Padding="8" BorderThickness="0,0,0,1" BorderBrush="#22808080">
          <DockPanel>
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="6">
              <Border Background="Transparent" ToolTip.Tip="{Binding #ZfsRefreshButton.Tag}">
                <Button Name="ZfsRefreshButton" Theme="{StaticResource JbIconButton}">
                  <Path Data="{StaticResource IconRefresh}" Width="16" Height="16"
                        Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.2" />
                </Button>
              </Border>
              <Border Background="Transparent" ToolTip.Tip="{Binding #NewPoolButton.Tag}">
                <Button Name="NewPoolButton" Content="New pool" Classes="accent" />
              </Border>
              <Border Background="Transparent" ToolTip.Tip="{Binding #NewDatasetButton.Tag}">
                <Button Name="NewDatasetButton" Content="New dataset" />
              </Border>
              <Border Background="Transparent" ToolTip.Tip="{Binding #ImportPoolButton.Tag}">
                <Button Name="ImportPoolButton" Content="Import pool" />
              </Border>
            </StackPanel>
            <c:FilterBox DockPanel.Dock="Right" Name="ZfsSearch" Width="200" Margin="10,0,0,0"
                         PlaceholderText="Search pools and datasets"
                         ToolTip.Tip="Narrows the tree in hand (Ctrl+F). Matches the full name and the mount point, and keeps a match's parents above it so nothing is left hanging at an indent with nothing over it." />
            <Panel />
          </DockPanel>
        </Border>

        <!-- **One column set true of a pool and of a dataset alike**, which is what lets the two be
             rows of one tree rather than two tables stacked. Used, Avail and Refer are `zfs`'s
             figures at every depth and never `zpool`'s ALLOC and FREE, so a parent's number covers
             its children's; the pool's own raw size, how full it is, its fragmentation, its dedup
             ratio and its health word are on the row's hover and in the details window, and the
             coloured dot is what keeps health on screen.

             Mount point is the fill column, so the numbers read left to right into the one cell that
             holds a path. -->
        <Border DockPanel.Dock="Top" Padding="12,3" Background="#11808080"
                BorderThickness="0,0,0,1" BorderBrush="#22808080">
          <DockPanel Name="ZfsHeaderStrip">
            <c:ColumnHeader DockPanel.Dock="Left" Text="Name" SortKey="name" Indent="30"
                            Width="{StaticResource ColNode}"
                            Tip="A pool, and the filesystems and volumes inside it. A row shows its own last name; the whole path is on the hover and on Copy name." />
            <c:ColumnHeader DockPanel.Dock="Left" Text="Type" SortKey="type"
                            Width="{StaticResource ColNodeType}" />
            <c:ColumnHeader DockPanel.Dock="Left" Text="Used" SortKey="used"
                            Width="{StaticResource ColNodeUsed}"
                            Tip="What this row and everything under it takes up, as zfs counts it. A pool's raw capacity counts parity too and is in the pool details window." />
            <c:ColumnHeader DockPanel.Dock="Left" Text="Avail" SortKey="avail"
                            Width="{StaticResource ColNodeAvail}"
                            Tip="What is left, after any quota set on this dataset or above it." />
            <c:ColumnHeader DockPanel.Dock="Left" Text="Refer" SortKey="refer"
                            Width="{StaticResource ColNodeRefer}"
                            Tip="What this row's own data takes up, without its children's. Used minus Refer is what is nested inside it." />
            <c:ColumnHeader DockPanel.Dock="Left" Text="Compress" SortKey="compress"
                            Width="{StaticResource ColNodeCompress}"
                            Tip="Which compression is set, not what it bought. The ratio is on the row's hover, because a number per row only means anything beside the data it is about." />
            <c:ColumnHeader Text="Mount point" SortKey="mount"
                            Tip="Where a filesystem mounts. Blank on a volume, which has no mount point at all rather than one it is not using. legacy and none are ZFS's own words." />
          </DockPanel>
        </Border>

        <Panel>
          <!-- Multiple, so Copy name can take several at once and a scrub can be started on a few
               pools in one go. The single-selection commands (details, edit, rename, destroy) say so
               by being disabled on anything else. -->
          <ListBox Name="ZfsTree" SelectionMode="Multiple" Background="Transparent" Padding="0"
                   ItemContainerTheme="{StaticResource JbTableRow}">
            <ListBox.ContextMenu>
              <ContextMenu Name="ZfsMenu">
                <MenuItem Name="MenuPoolDetails" Header="Pool details" />
                <Separator />
                <MenuItem Name="MenuNewDataset" Header="New dataset" />
                <MenuItem Name="MenuEditDataset" Header="Edit properties" />
                <MenuItem Name="MenuRenameDataset" Header="Rename dataset" />
                <MenuItem Name="MenuDestroyDataset" Header="Destroy dataset" />
                <Separator />
                <MenuItem Name="MenuScrub" Header="Start scrub" />
                <MenuItem Name="MenuStopScrub" Header="Stop scrub" />
                <Separator />
                <MenuItem Name="MenuExport" Header="Export pool" />
                <MenuItem Name="MenuDestroy" Header="Destroy pool" />
                <Separator />
                <MenuItem Name="MenuExpandAll" Header="Expand all" />
                <MenuItem Name="MenuCollapseAll" Header="Collapse all" />
                <MenuItem Name="MenuCopyPoolName" Header="Copy name" />
              </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemTemplate>
              <DataTemplate DataType="vm:ZfsNodeRow">

                <!-- A DockPanel and not a StackPanel, for the reason the disks row is one: a
                     StackPanel measures its children with infinite width, so the fill cell's
                     TextTrimming never fires and a long mount path runs off the edge while the
                     heading above it has been squeezed to nothing. -->
                <DockPanel Classes="cells" ToolTip.Tip="{Binding Summary}">

                  <DockPanel DockPanel.Dock="Left" Width="{StaticResource ColNode}">

                    <!-- **The indent is a Border with a bound Width, never a Margin.** The row's
                         hover and selection paint a Border along with everything else in the row; a
                         margin would leave a dead strip down the left of every nested row that looks
                         like part of the table and is not part of the row. DiskPartitionsView and
                         PoolTopologyView draw their indent the same way. -->
                    <Border DockPanel.Dock="Left" Width="{Binding IndentPixels}" />

                    <!-- The chevron is a Button inside the row and the click is caught once on the
                         list rather than wired per row, which is the idiom the services module uses
                         for its in-row autostart tick. A row with nothing under it keeps the slot at
                         its width rather than losing it, so every name at one depth starts in the
                         same place. -->
                    <Button DockPanel.Dock="Left" Theme="{StaticResource JbToolButton}"
                            IsVisible="{Binding ShowChevron}" Padding="0" Width="16" Height="16"
                            MinHeight="0" VerticalAlignment="Center">
                      <Path Data="{Binding ChevronData}" Width="16" Height="16"
                            Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.2" />
                    </Button>
                    <Border DockPanel.Dock="Left" Width="16" IsVisible="{Binding NoChevron}" />

                    <!-- Only a pool gets a dot: a dataset is a fact, a pool is a thing that can be
                         dying. The slot keeps its width either way, so a dataset's name lines up
                         with its pool's. -->
                    <Panel DockPanel.Dock="Left" Width="14">
                      <Ellipse Width="9" Height="9" HorizontalAlignment="Left" VerticalAlignment="Center"
                               Fill="{Binding StateBrush}" IsVisible="{Binding IsPool}"
                               ToolTip.Tip="{Binding HealthTip}" />
                    </Panel>

                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                  </DockPanel>

                  <TextBlock DockPanel.Dock="Left" Text="{Binding TypeText}"
                             Width="{StaticResource ColNodeType}" VerticalAlignment="Center" />
                  <TextBlock DockPanel.Dock="Left" Text="{Binding UsedText}"
                             Width="{StaticResource ColNodeUsed}" VerticalAlignment="Center" />
                  <TextBlock DockPanel.Dock="Left" Text="{Binding AvailText}"
                             Width="{StaticResource ColNodeAvail}" VerticalAlignment="Center" />
                  <TextBlock DockPanel.Dock="Left" Text="{Binding ReferText}"
                             Width="{StaticResource ColNodeRefer}" VerticalAlignment="Center" />
                  <TextBlock DockPanel.Dock="Left" Text="{Binding CompressText}"
                             Width="{StaticResource ColNodeCompress}" VerticalAlignment="Center" />

                  <TextBlock Text="{Binding MountText}" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" />
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- Why the table is empty. Six answers, because they are six different situations and only
               one of them is "this host has no pools": no zpool at all, the userland present with the
               kernel module not loaded, a pool listing that failed, a listing nobody could run, a
               dataset listing that failed under pools that read perfectly well, and a host that
               genuinely has none. -->
          <TextBlock Name="ZfsEmpty" Opacity="0.6" IsVisible="False"
                     TextAlignment="Center" TextWrapping="Wrap" MaxWidth="440"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Panel>

      </DockPanel>
    </TabItem>

  </TabControl>
</UserControl>
