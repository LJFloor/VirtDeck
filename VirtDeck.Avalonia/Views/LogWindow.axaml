<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="VirtDeck.Avalonia.Views.LogWindow"
        Title="VirtDeck — Diagnostics"
        Width="900" Height="560"
        WindowStartupLocation="CenterScreen">

  <DockPanel>
    <Border DockPanel.Dock="Bottom" Padding="10,8" BorderThickness="0,1,0,0" BorderBrush="#22808080">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <CheckBox Name="VerboseCheck" Content="Verbose (per-frame)" />
        <CheckBox Name="AutoScrollCheck" Content="Auto-scroll" IsChecked="True" />
        <Border Width="1" Margin="4,2" Background="#33808080" />
        <Button Name="CopyButton" Content="Copy" />
        <Button Name="ClearButton" Content="Clear" />
        <Button Name="OpenFileButton" Content="Open log file" />
      </StackPanel>
    </Border>

    <TextBox Name="LogText" AcceptsReturn="True" IsReadOnly="True" TextWrapping="NoWrap"
             FontFamily="monospace" FontSize="12" BorderThickness="0" />
  </DockPanel>
</Window>
