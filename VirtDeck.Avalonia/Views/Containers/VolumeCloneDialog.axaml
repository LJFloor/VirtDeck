<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="VirtDeck.Avalonia.Views.Containers.VolumeCloneDialog"
        Title="Clone volume"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" CanResize="False">

  <DockPanel Margin="16">

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                HorizontalAlignment="Right" Spacing="8" Margin="0,20,0,0">
      <Button Name="CancelButton" Content="Cancel" MinWidth="88" IsCancel="True" />
      <Button Name="CloneButton" Content="Clone" MinWidth="88" IsDefault="True" Classes="accent" />
    </StackPanel>

    <StackPanel Classes="page">

      <TextBlock Name="NoteText" Classes="note" TextWrapping="Wrap" />

      <Grid ColumnDefinitions="90,*">
        <TextBlock Grid.Column="0" Text="New name" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Name="NameBox" />
      </Grid>

      <TextBlock Name="ErrorText" Classes="error" TextWrapping="Wrap" IsVisible="False" />

    </StackPanel>
  </DockPanel>
</Window>
