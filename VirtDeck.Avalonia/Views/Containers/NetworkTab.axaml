<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:VirtDeck.Avalonia.Controls"
             xmlns:rows="clr-namespace:VirtDeck.Avalonia.Views.Containers"
             x:Class="VirtDeck.Avalonia.Views.Containers.NetworkTab">

  <DockPanel Margin="16">

    <Grid DockPanel.Dock="Top" Margin="0,0,0,12" ColumnDefinitions="110,*">
      <TextBlock Grid.Column="0" Text="Attach to" VerticalAlignment="Center" />
      <ComboBox Grid.Column="1" Name="NetworkBox" HorizontalAlignment="Stretch" />
    </Grid>

    <!-- Everything docker refuses under container: networking, where the container joins another
         one's namespace and has no host name, resolver or hosts file of its own. Note this is a
         narrower rule than the ports one below: measured on docker 29, host networking refuses a
         published port and accepts all three of these. -->
    <StackPanel Name="AddressingSection" DockPanel.Dock="Top" Margin="0,0,0,12" Spacing="6">
      <Grid ColumnDefinitions="110,*" Margin="0,0,0,6">
        <TextBlock Grid.Column="0" Text="Host name" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Name="HostnameBox"
                 PlaceholderText="the container's own id" />
      </Grid>

      <HeaderedContentControl Padding="0" Theme="{StaticResource JbGroupBox}" Header="DNS servers">
        <DockPanel>
          <c:RowToolbar DockPanel.Dock="Top" Name="DnsTools" Margin="8,6,8,6" ShowMove="True" />

          <Border DockPanel.Dock="Top" Padding="12,3" Background="#11808080"
                  BorderThickness="0,0,0,1" BorderBrush="#22808080">
            <Grid ColumnDefinitions="*" ColumnSpacing="6">
              <TextBlock Grid.Column="0" Classes="columnheader" Text="Address" />
            </Grid>
          </Border>

          <ListBox Name="DnsList" Background="Transparent" Padding="0" BorderThickness="0"
                   ItemContainerTheme="{StaticResource JbFormRow}"
                   KeyboardNavigation.TabNavigation="Continue">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate DataType="rows:TextRow">
                <Grid ColumnDefinitions="*" ColumnSpacing="6">
                  <TextBox Grid.Column="0" PlaceholderText="1.1.1.1"
                           Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </HeaderedContentControl>

      <HeaderedContentControl Padding="0" Theme="{StaticResource JbGroupBox}" Header="Extra hosts">
        <DockPanel>
          <c:RowToolbar DockPanel.Dock="Top" Name="HostEntryTools" Margin="8,6,8,6" />

          <Border DockPanel.Dock="Top" Padding="12,3" Background="#11808080"
                  BorderThickness="0,0,0,1" BorderBrush="#22808080">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
              <TextBlock Grid.Column="0" Classes="columnheader" Text="Name" />
              <TextBlock Grid.Column="1" Classes="columnheader" Text="Address" />
            </Grid>
          </Border>

          <ListBox Name="HostEntryList" Background="Transparent" Padding="0" BorderThickness="0"
                   ItemContainerTheme="{StaticResource JbFormRow}"
                   KeyboardNavigation.TabNavigation="Continue">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate DataType="rows:HostEntryRow">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                  <TextBox Grid.Column="0" PlaceholderText="db"
                           Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBox Grid.Column="1" PlaceholderText="10.0.0.5"
                           Text="{Binding Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </HeaderedContentControl>

      <TextBlock Classes="note"
                 Text="A host name left empty leaves docker's own, which is the container's id. The DNS servers replace what the container would otherwise inherit from the host, in order; the extra hosts are lines written into its /etc/hosts." />
    </StackPanel>

    <HeaderedContentControl Name="PortsSection" Padding="0"
                            Theme="{StaticResource JbGroupBox}" Header="Port mappings">
      <DockPanel>
        <c:RowToolbar DockPanel.Dock="Top" Name="PortTools" Margin="8,6,8,6" />

        <!-- The same table the main window draws: a heading strip in JbGroupBoxHeader's
             grey over a rule, and rows on the window's own background. 12px of padding, so
             the headings sit over the cells rather than beside them, matching JbTableRow. -->
        <Border DockPanel.Dock="Top" Padding="12,3" Background="#11808080"
                BorderThickness="0,0,0,1" BorderBrush="#22808080">
          <Grid ColumnDefinitions="100,100,90,*" ColumnSpacing="6">
            <TextBlock Grid.Column="0" Classes="columnheader" Text="In container" />
            <TextBlock Grid.Column="1" Classes="columnheader" Text="On the host" />
            <TextBlock Grid.Column="2" Classes="columnheader" Text="Protocol" />
          </Grid>
        </Border>

        <!-- No border of its own: the group box already draws one, and the rows are meant to run
             right up to it. -->
        <ListBox Name="PortList" Background="Transparent" Padding="0" BorderThickness="0"
                 ItemContainerTheme="{StaticResource JbFormRow}"
                 KeyboardNavigation.TabNavigation="Continue">
          <!-- Not virtualised: an unrealised row has no cells for Tab to reach, and these lists are
               a handful of rows, never a listing. -->
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="rows:PortRow">
              <Grid ColumnDefinitions="100,100,90,*" ColumnSpacing="6">
                <TextBox Grid.Column="0" PlaceholderText="80"
                         Text="{Binding ContainerPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Grid.Column="1" PlaceholderText="80"
                         Text="{Binding HostPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <ComboBox Grid.Column="2" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding Protocols}" SelectedItem="{Binding Protocol, Mode=TwoWay}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </HeaderedContentControl>

  </DockPanel>
</UserControl>
