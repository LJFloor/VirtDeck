<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:edit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
        xmlns:c="clr-namespace:VirtDeck.Avalonia.Controls"
        x:Class="VirtDeck.Avalonia.Views.Containers.StackEditWindow"
        Title="New stack"
        Width="820" Height="620" MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterOwner">

  <DockPanel Margin="16">

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <Button Name="CancelButton" Content="Cancel" MinWidth="88" IsCancel="True" />
      <Button Name="SaveButton" Content="Save" MinWidth="88" />
      <!-- The accented one is the button that brings something onto the host, which on this window
           is the one that also deploys. Not IsDefault: Enter belongs to the editor. -->
      <Button Name="SaveDeployButton" Content="Save and deploy" MinWidth="120" Classes="accent" />
    </StackPanel>

    <Grid DockPanel.Dock="Top" ColumnDefinitions="90,*" RowDefinitions="Auto,Auto"
          RowSpacing="6" Margin="0,0,0,10">
      <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" VerticalAlignment="Center" />
      <TextBox Grid.Row="0" Grid.Column="1" Name="NameBox" />

      <!-- Only when a discovered stack names more than one file. A stack VirtDeck wrote always has
           exactly one, so the row is simply not part of the window in the common case. -->
      <TextBlock Grid.Row="1" Grid.Column="0" Name="FileLabel" Text="File"
                 VerticalAlignment="Center" IsVisible="False" />
      <ComboBox Grid.Row="1" Grid.Column="1" Name="FileBox" HorizontalAlignment="Stretch"
                IsVisible="False" />
    </Grid>

    <TextBlock DockPanel.Dock="Bottom" Name="ErrorText" Classes="error"
               IsVisible="False" Margin="0,10,0,0" />

    <!-- Read-only stacks say why up here, above the file rather than under it, so the reason is
         read before the text it applies to. -->
    <TextBlock DockPanel.Dock="Bottom" Name="ReadOnlyNote" Classes="note"
               IsVisible="False" Margin="0,10,0,0" />

    <Border BorderThickness="1" BorderBrush="{DynamicResource JbGroupBoxBorder}">
      <edit:TextEditor Name="Editor" ShowLineNumbers="True"
                       c:CodeEditor.Language="Yaml"
                       HorizontalScrollBarVisibility="Auto"
                       VerticalScrollBarVisibility="Auto" />
    </Border>

  </DockPanel>
</Window>
