<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="VirtDeck.Avalonia.Views.Containers.ContainerConsoleDialog"
        Title="Console"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" CanResize="False">

  <DockPanel Margin="16">

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                HorizontalAlignment="Right" Spacing="8" Margin="0,20,0,0">
      <Button Name="CancelButton" Content="Cancel" MinWidth="88" IsCancel="True" />
      <Button Name="ConnectButton" Content="Connect" MinWidth="88" IsDefault="True" Classes="accent" />
    </StackPanel>

    <StackPanel Classes="page">

      <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto" RowSpacing="6">
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Command" VerticalAlignment="Center" />
        <TextBox Grid.Row="0" Grid.Column="1" Name="CommandBox" Text="/bin/bash" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="User" VerticalAlignment="Center" />
        <TextBox Grid.Row="1" Grid.Column="1" Name="UserBox" PlaceholderText="root" />
      </Grid>

      <TextBlock Name="ErrorText" Classes="error" TextWrapping="Wrap" IsVisible="False" />

    </StackPanel>
  </DockPanel>
</Window>
