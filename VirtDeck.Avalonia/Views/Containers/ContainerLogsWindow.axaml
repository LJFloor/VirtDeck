<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:VirtDeck.Avalonia.Controls"
        x:Class="VirtDeck.Avalonia.Views.Containers.ContainerLogsWindow"
        Title="Logs"
        Width="900" Height="560" MinWidth="480" MinHeight="300"
        WindowStartupLocation="CenterOwner">

  <DockPanel>

    <Border DockPanel.Dock="Bottom" Theme="{StaticResource JbDialogFooter}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8">
          <!-- There is no Follow toggle, and its absence is the decision rather than an omission.
               Following is what the window is for: docker streams the log, and a container that
               stops and starts again is picked back up.

               The checkbox that was here read as a toggle for the *view*, which is what nearly every
               log viewer means by the word, and that half is now unconditional: the view follows the
               newest line while it is sitting at the bottom, and scrolling up holds its place
               instead, so a log can be read while it is still being written to. What the checkbox
               actually controlled was the stream, and giving that up costs one thing worth knowing
               about: with the stream always live a chatty container goes on evicting history under a
               reader who has scrolled up, because MaxScrollback is 5000 lines and past that an old
               line is dropped for each one arriving. Reload is what starts again from the top. -->
          <Button Name="ReloadButton" Content="Reload" MinWidth="72" />
          <Button Name="CopyButton" Content="Copy" MinWidth="72" />
          <Button Name="ClearButton" Content="Clear" MinWidth="72" />
        </StackPanel>
        <!-- Whether the stream is live, why it ended, or what docker refused. -->
        <TextBlock Name="StatusText" Margin="12,0,0,0"
                   VerticalAlignment="Center" Opacity="0.75" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <!-- Both bars are the window's rather than the control's, as the vertical one is on the console
         window, so the terminal itself stays a plain grid of cells. The horizontal one is docked
         first so that it runs the full width and the vertical one stops above it. -->
    <ScrollBar Name="ScrollX" DockPanel.Dock="Bottom" Orientation="Horizontal"
               Visibility="Visible" AllowAutoHide="False" Minimum="0" SmallChange="1" />
    <ScrollBar Name="Scroll" DockPanel.Dock="Right" Orientation="Vertical"
               Visibility="Visible" AllowAutoHide="False" Minimum="0" SmallChange="1" />

    <!-- The same TerminalControl the container console uses, read-only. A container's log is a
         terminal's output and was being drawn as if it were plain text: an image that colours what
         it prints came out as ESC[31m runs, and anything redrawing a line with a carriage return
         left its fragments stacked. It also means one display for the whole app rather than a
         second one, and a cell buffer bounded in lines rather than a TextBox laying out a megabyte
         of text with no virtualization.

         The box this replaced was deliberately unwrapped, and WrapColumns is what keeps that from
         becoming a regression. A terminal folds at its column count, and folding a long record onto
         the next row makes it indistinguishable from the next record, which is what a log must not
         be; turning autowrap off instead would truncate, with nothing to scroll to for the rest. So
         the screen is 512 columns wide whatever the window is, a record runs off to the right the
         way it did in the text box, and the bar below reaches it. Only a record longer than that
         folds. The width is not free: it is what a line costs while it is on screen, and it is why
         TerminalScreen trims a line's trailing blanks on its way into history, without which a full
         scrollback here would be 61 MB. -->
    <c:TerminalControl Name="Terminal" ReadOnly="True" WrapColumns="512" />

  </DockPanel>
</Window>
