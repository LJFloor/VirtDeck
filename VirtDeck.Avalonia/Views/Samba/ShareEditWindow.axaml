<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sf="clr-namespace:VirtDeck.Avalonia.Views.Samba"
        x:Class="VirtDeck.Avalonia.Views.Samba.ShareEditWindow"
        Title="New shared folder"
        Width="820" Height="600" MinWidth="680" MinHeight="460"
        WindowStartupLocation="CenterOwner">

  <DockPanel>

    <Border DockPanel.Dock="Bottom" Theme="{StaticResource JbDialogFooter}">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Name="StatusText" Margin="0,0,12,0"
                   VerticalAlignment="Center" Opacity="0.75" TextTrimming="CharacterEllipsis" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Name="CancelButton" Content="Cancel" MinWidth="88" IsCancel="True" />
          <Button Name="SaveButton" Content="Create" MinWidth="88" IsDefault="True" Classes="accent" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Pages on the left, one on the right. They are not named: the window walks these items and
         talks to whichever of them implement ISambaShareTab, so a new page is a TabItem here and
         nothing else. -->
    <TabControl Name="SectionTabs" Theme="{StaticResource JbSideTabControl}">
      <TabItem Header="General"><sf:ShareGeneralTab /></TabItem>
      <TabItem Header="Permissions"><sf:SharePermissionsTab /></TabItem>
      <TabItem Header="Advanced"><sf:ShareAdvancedTab /></TabItem>
    </TabControl>

  </DockPanel>
</Window>
