<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="VirtDeck.Avalonia.Views.Users.GroupAddDialog"
        Title="New group"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" CanResize="False">

  <DockPanel Margin="16">

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                HorizontalAlignment="Right" Spacing="8" Margin="0,20,0,0">
      <Button Name="CancelButton" Content="Cancel" MinWidth="88" IsCancel="True" />
      <Button Name="CreateButton" Content="Create" MinWidth="88" IsDefault="True" Classes="accent" />
    </StackPanel>

    <StackPanel Classes="page">

      <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto" RowSpacing="6">
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" VerticalAlignment="Center" />
        <TextBox Grid.Row="0" Grid.Column="1" Name="NameBox" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Group ID" VerticalAlignment="Center" />
        <TextBox Grid.Row="1" Grid.Column="1" Name="GidBox" PlaceholderText="next free" />
      </Grid>

      <TextBlock Classes="note" TextWrapping="Wrap"
                 Text="Leave the ID blank and the host picks the next free one, which is almost always what you want. Add accounts to the group by editing them." />

      <TextBlock Name="ErrorText" Classes="error" TextWrapping="Wrap" IsVisible="False" />

    </StackPanel>
  </DockPanel>
</Window>
