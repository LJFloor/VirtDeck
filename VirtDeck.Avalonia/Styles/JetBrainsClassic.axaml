<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Buttons and text fields in the JetBrains "Classic UI" register: flat fills, 1px hairline
    borders, 3px corners and tight padding. Dark values are Darcula's own ramp (#4C5052 button
    face, #45494A field face, #BBBBBB text, #365880 default button, #466D94 focus); Light follows
    classic IntelliJ Light.

    Merged into Application.Resources rather than Application.Styles: resource lookup reaches
    Application.Resources before the FluentTheme's own dictionaries, so the TextControl* overrides
    below deterministically win over Fluent's without needing /template/ selectors for every state.
  -->

  <ResourceDictionary.ThemeDictionaries>

    <ResourceDictionary x:Key="Dark">
      <!-- Buttons -->
      <SolidColorBrush x:Key="JbButtonBackground" Color="#FF4C5052" />
      <SolidColorBrush x:Key="JbButtonBackgroundHover" Color="#FF55595B" />
      <SolidColorBrush x:Key="JbButtonBackgroundPressed" Color="#FF43474A" />
      <SolidColorBrush x:Key="JbButtonBackgroundDisabled" Color="#FF3C3F41" />
      <SolidColorBrush x:Key="JbButtonBorder" Color="#FF5E6060" />
      <SolidColorBrush x:Key="JbButtonBorderHover" Color="#FF6B6E6F" />
      <SolidColorBrush x:Key="JbButtonBorderDisabled" Color="#FF4E5052" />
      <SolidColorBrush x:Key="JbButtonForeground" Color="#FFBBBBBB" />
      <SolidColorBrush x:Key="JbButtonForegroundDisabled" Color="#FF777777" />
      <SolidColorBrush x:Key="JbButtonFocusBorder" Color="#FF466D94" />

      <SolidColorBrush x:Key="JbDefaultButtonBackground" Color="#FF365880" />
      <SolidColorBrush x:Key="JbDefaultButtonBackgroundHover" Color="#FF3D6493" />
      <SolidColorBrush x:Key="JbDefaultButtonBackgroundPressed" Color="#FF2E4C70" />
      <SolidColorBrush x:Key="JbDefaultButtonBorder" Color="#FF4C708C" />
      <SolidColorBrush x:Key="JbDefaultButtonForeground" Color="#FFBBBBBB" />

      <!-- Text fields: Fluent's own keys, repainted. The face does not change on hover or focus
           (JetBrains only moves the border), so all three background keys are the same value. -->
      <SolidColorBrush x:Key="TextControlBackground" Color="#FF45494A" />
      <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FF45494A" />
      <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FF45494A" />
      <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#FF3C3F41" />

      <SolidColorBrush x:Key="TextControlBorderBrush" Color="#FF646464" />
      <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#FF7A7A7A" />
      <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#FF466D94" />
      <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#FF4E5052" />

      <SolidColorBrush x:Key="TextControlForeground" Color="#FFBBBBBB" />
      <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#FFBBBBBB" />
      <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFBBBBBB" />
      <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#FF777777" />

      <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#FF808080" />
      <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#FF808080" />
      <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#FF808080" />
      <SolidColorBrush x:Key="TextControlPlaceholderForegroundDisabled" Color="#FF5E6060" />

      <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#FF214283" />

      <!-- Dropdowns: the closed ComboBox is a text field with a chevron, so every background/border
           key tracks the TextControl* values above. Fluent swaps in a second "HighlightBackground"
           layer while focused or open (ComboBoxBackground*Unfocused/*BorderBrushFocused); those are
           painted to the same face so only the border colour moves, as on a text field. -->
      <SolidColorBrush x:Key="ComboBoxBackground" Color="#FF45494A" />
      <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#FF45494A" />
      <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#FF45494A" />
      <SolidColorBrush x:Key="ComboBoxBackgroundUnfocused" Color="#FF45494A" />
      <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="#FF3C3F41" />

      <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#FF646464" />
      <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#FF7A7A7A" />
      <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#FF466D94" />
      <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled" Color="#FF4E5052" />
      <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushFocused" Color="#FF466D94" />
      <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushUnfocused" Color="#FF646464" />

      <SolidColorBrush x:Key="ComboBoxForeground" Color="#FFBBBBBB" />
      <SolidColorBrush x:Key="ComboBoxForegroundFocused" Color="#FFBBBBBB" />
      <SolidColorBrush x:Key="ComboBoxForegroundFocusedPressed" Color="#FFBBBBBB" />
      <SolidColorBrush x:Key="ComboBoxForegroundDisabled" Color="#FF777777" />

      <SolidColorBrush x:Key="ComboBoxPlaceHolderForeground" Color="#FF808080" />
      <SolidColorBrush x:Key="ComboBoxPlaceHolderForegroundFocusedPressed" Color="#FF808080" />

      <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="#FFBBBBBB" />
      <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundFocused" Color="#FFBBBBBB" />
      <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundFocusedPressed" Color="#FFBBBBBB" />
      <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundDisabled" Color="#FF777777" />

      <!-- The open list is a popup panel, not a field: window face, hairline frame, and the same
           row colours the tables use. -->
      <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FF3C3F41" />
      <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#FF646464" />

      <SolidColorBrush x:Key="ComboBoxItemBackground" Color="Transparent" />
      <SolidColorBrush x:Key="ComboBoxItemBackgroundDisabled" Color="Transparent" />
      <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#FF3E4245" />
      <SolidColorBrush x:Key="ComboBoxItemBackgroundPressed" Color="#FF4B6EAF" />
      <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#FF4B6EAF" />
      <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedDisabled" Color="#FF3E4245" />
      <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="#FF4B6EAF" />
      <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPressed" Color="#FF4B6EAF" />

      <SolidColorBrush x:Key="ComboBoxItemBorderBrushDisabled" Color="Transparent" />
      <SolidColorBrush x:Key="ComboBoxItemBorderBrushPointerOver" Color="Transparent" />
      <SolidColorBrush x:Key="ComboBoxItemBorderBrushPressed" Color="Transparent" />
      <SolidColorBrush x:Key="ComboBoxItemBorderBrushSelected" Color="Transparent" />
      <SolidColorBrush x:Key="ComboBoxItemBorderBrushSelectedDisabled" Color="Transparent" />
      <SolidColorBrush x:Key="ComboBoxItemBorderBrushSelectedPointerOver" Color="Transparent" />
      <SolidColorBrush x:Key="ComboBoxItemBorderBrushSelectedPressed" Color="Transparent" />

      <SolidColorBrush x:Key="ComboBoxItemForeground" Color="#FFBBBBBB" />
      <SolidColorBrush x:Key="ComboBoxItemForegroundPointerOver" Color="#FFBBBBBB" />
      <SolidColorBrush x:Key="ComboBoxItemForegroundPressed" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="ComboBoxItemForegroundDisabled" Color="#FF777777" />
      <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedDisabled" Color="#FF777777" />
      <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPointerOver" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPressed" Color="#FFFFFFFF" />

      <!-- Toolbars: the strip sits a shade above the window face, items are borderless until hovered. -->
      <SolidColorBrush x:Key="JbToolBarBackground" Color="#FF3C3F41" />
      <SolidColorBrush x:Key="JbToolBarBorder" Color="#FF323232" />
      <SolidColorBrush x:Key="JbToolBarItemHover" Color="#FF4C5052" />
      <SolidColorBrush x:Key="JbToolBarItemPressed" Color="#FF2F3133" />

      <!-- Menus: window face behind a hairline frame; the highlighted row is the selection blue the
           tables use, full width, not a gray inset pill. -->
      <SolidColorBrush x:Key="JbMenuBackground" Color="#FF3C3F41" />
      <SolidColorBrush x:Key="JbMenuBorder" Color="#FF616161" />
      <SolidColorBrush x:Key="JbMenuForeground" Color="#FFBBBBBB" />
      <SolidColorBrush x:Key="JbMenuForegroundDisabled" Color="#FF777777" />
      <SolidColorBrush x:Key="JbMenuItemSelected" Color="#FF4B6EAF" />
      <SolidColorBrush x:Key="JbMenuItemSelectedForeground" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="JbMenuSeparator" Color="#FF515151" />

      <!-- Tabs: flat cells on a strip a shade off the window face; the selected one is marked by a
           2px underline, not by a raised card. -->
      <SolidColorBrush x:Key="JbTabStripBackground" Color="#FF3C3F41" />
      <SolidColorBrush x:Key="JbTabHoverBackground" Color="#FF4C5052" />
      <SolidColorBrush x:Key="JbTabSelectedBackground" Color="#FF4E5254" />
      <SolidColorBrush x:Key="JbTabSelectedUnderline" Color="#FF4A88C7" />

      <!-- Table rows -->
      <SolidColorBrush x:Key="JbListItemHover" Color="#FF3E4245" />
      <SolidColorBrush x:Key="JbListItemSelected" Color="#FF4B6EAF" />
      <SolidColorBrush x:Key="JbListItemSelectedForeground" Color="#FFFFFFFF" />

      <!-- Inline validation text: IntelliJ's error red, which is muted enough to sit in a form
           without shouting. Use it for a message about something the user must change, never for
           ordinary hints; those are the 0.7-opacity note style. -->
      <SolidColorBrush x:Key="JbErrorForeground" Color="#FFC75450" />

      <!-- The container console's own surface and the sixteen colours an escape sequence can name.
           Darcula's terminal palette. The other 240 of the 256 are computed (a 6x6x6 cube and 24
           greys) and are the same on either face, because they are absolute colours; only these
           sixteen and the two defaults are a matter of taste, so only these are themed. -->
      <SolidColorBrush x:Key="JbTerminalBackground" Color="#FF1E1F22" />
      <SolidColorBrush x:Key="JbTerminalForeground" Color="#FFBCBEC4" />
      <SolidColorBrush x:Key="JbTerminalSelection" Color="#FF2E436E" />
      <SolidColorBrush x:Key="JbTerminalCursor" Color="#FFBCBEC4" />
      <Color x:Key="JbTerminal0">#FF000000</Color>
      <Color x:Key="JbTerminal1">#FFCD3131</Color>
      <Color x:Key="JbTerminal2">#FF0DBC79</Color>
      <Color x:Key="JbTerminal3">#FFE5E510</Color>
      <Color x:Key="JbTerminal4">#FF3B8EEA</Color>
      <Color x:Key="JbTerminal5">#FFBC3FBC</Color>
      <Color x:Key="JbTerminal6">#FF11A8CD</Color>
      <Color x:Key="JbTerminal7">#FFE5E5E5</Color>
      <Color x:Key="JbTerminal8">#FF666666</Color>
      <Color x:Key="JbTerminal9">#FFF14C4C</Color>
      <Color x:Key="JbTerminal10">#FF23D18B</Color>
      <Color x:Key="JbTerminal11">#FFF5F543</Color>
      <Color x:Key="JbTerminal12">#FF3B8EEA</Color>
      <Color x:Key="JbTerminal13">#FFD670D6</Color>
      <Color x:Key="JbTerminal14">#FF29B8DB</Color>
      <Color x:Key="JbTerminal15">#FFFFFFFF</Color>
    </ResourceDictionary>

    <ResourceDictionary x:Key="Light">
      <!-- Buttons -->
      <SolidColorBrush x:Key="JbButtonBackground" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="JbButtonBackgroundHover" Color="#FFF0F0F0" />
      <SolidColorBrush x:Key="JbButtonBackgroundPressed" Color="#FFE1E1E1" />
      <SolidColorBrush x:Key="JbButtonBackgroundDisabled" Color="#FFF5F5F5" />
      <SolidColorBrush x:Key="JbButtonBorder" Color="#FFC4C4C4" />
      <SolidColorBrush x:Key="JbButtonBorderHover" Color="#FFADADAD" />
      <SolidColorBrush x:Key="JbButtonBorderDisabled" Color="#FFDDDDDD" />
      <SolidColorBrush x:Key="JbButtonForeground" Color="#FF000000" />
      <SolidColorBrush x:Key="JbButtonForegroundDisabled" Color="#FF8C8C8C" />
      <SolidColorBrush x:Key="JbButtonFocusBorder" Color="#FF4A88C7" />

      <SolidColorBrush x:Key="JbDefaultButtonBackground" Color="#FF4A88C7" />
      <SolidColorBrush x:Key="JbDefaultButtonBackgroundHover" Color="#FF5591CE" />
      <SolidColorBrush x:Key="JbDefaultButtonBackgroundPressed" Color="#FF3F79B4" />
      <SolidColorBrush x:Key="JbDefaultButtonBorder" Color="#FF3D77B0" />
      <SolidColorBrush x:Key="JbDefaultButtonForeground" Color="#FFFFFFFF" />

      <!-- Text fields -->
      <SolidColorBrush x:Key="TextControlBackground" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#FFF5F5F5" />

      <SolidColorBrush x:Key="TextControlBorderBrush" Color="#FFC4C4C4" />
      <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#FFADADAD" />
      <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#FF4A88C7" />
      <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#FFDDDDDD" />

      <SolidColorBrush x:Key="TextControlForeground" Color="#FF000000" />
      <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#FF000000" />
      <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FF000000" />
      <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#FF8C8C8C" />

      <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#FF999999" />
      <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#FF999999" />
      <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#FF999999" />
      <SolidColorBrush x:Key="TextControlPlaceholderForegroundDisabled" Color="#FFC4C4C4" />

      <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#FFA6D2FF" />

      <!-- Dropdowns -->
      <SolidColorBrush x:Key="ComboBoxBackground" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="ComboBoxBackgroundUnfocused" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="#FFF5F5F5" />

      <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#FFC4C4C4" />
      <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#FFADADAD" />
      <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#FF4A88C7" />
      <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled" Color="#FFDDDDDD" />
      <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushFocused" Color="#FF4A88C7" />
      <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushUnfocused" Color="#FFC4C4C4" />

      <SolidColorBrush x:Key="ComboBoxForeground" Color="#FF000000" />
      <SolidColorBrush x:Key="ComboBoxForegroundFocused" Color="#FF000000" />
      <SolidColorBrush x:Key="ComboBoxForegroundFocusedPressed" Color="#FF000000" />
      <SolidColorBrush x:Key="ComboBoxForegroundDisabled" Color="#FF8C8C8C" />

      <SolidColorBrush x:Key="ComboBoxPlaceHolderForeground" Color="#FF999999" />
      <SolidColorBrush x:Key="ComboBoxPlaceHolderForegroundFocusedPressed" Color="#FF999999" />

      <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="#FF000000" />
      <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundFocused" Color="#FF000000" />
      <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundFocusedPressed" Color="#FF000000" />
      <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundDisabled" Color="#FF8C8C8C" />

      <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#FFC4C4C4" />

      <SolidColorBrush x:Key="ComboBoxItemBackground" Color="Transparent" />
      <SolidColorBrush x:Key="ComboBoxItemBackgroundDisabled" Color="Transparent" />
      <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#FFEDF3FE" />
      <SolidColorBrush x:Key="ComboBoxItemBackgroundPressed" Color="#FF3875D6" />
      <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#FF3875D6" />
      <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedDisabled" Color="#FFEDF3FE" />
      <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="#FF3875D6" />
      <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPressed" Color="#FF3875D6" />

      <SolidColorBrush x:Key="ComboBoxItemBorderBrushDisabled" Color="Transparent" />
      <SolidColorBrush x:Key="ComboBoxItemBorderBrushPointerOver" Color="Transparent" />
      <SolidColorBrush x:Key="ComboBoxItemBorderBrushPressed" Color="Transparent" />
      <SolidColorBrush x:Key="ComboBoxItemBorderBrushSelected" Color="Transparent" />
      <SolidColorBrush x:Key="ComboBoxItemBorderBrushSelectedDisabled" Color="Transparent" />
      <SolidColorBrush x:Key="ComboBoxItemBorderBrushSelectedPointerOver" Color="Transparent" />
      <SolidColorBrush x:Key="ComboBoxItemBorderBrushSelectedPressed" Color="Transparent" />

      <SolidColorBrush x:Key="ComboBoxItemForeground" Color="#FF000000" />
      <SolidColorBrush x:Key="ComboBoxItemForegroundPointerOver" Color="#FF000000" />
      <SolidColorBrush x:Key="ComboBoxItemForegroundPressed" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="ComboBoxItemForegroundDisabled" Color="#FF8C8C8C" />
      <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedDisabled" Color="#FF8C8C8C" />
      <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPointerOver" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPressed" Color="#FFFFFFFF" />

      <!-- Toolbars -->
      <SolidColorBrush x:Key="JbToolBarBackground" Color="#FFF2F2F2" />
      <SolidColorBrush x:Key="JbToolBarBorder" Color="#FFCDCDCD" />
      <SolidColorBrush x:Key="JbToolBarItemHover" Color="#FFDFDFDF" />
      <SolidColorBrush x:Key="JbToolBarItemPressed" Color="#FFCFCFCF" />

      <!-- Menus -->
      <SolidColorBrush x:Key="JbMenuBackground" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="JbMenuBorder" Color="#FFADADAD" />
      <SolidColorBrush x:Key="JbMenuForeground" Color="#FF000000" />
      <SolidColorBrush x:Key="JbMenuForegroundDisabled" Color="#FF8C8C8C" />
      <SolidColorBrush x:Key="JbMenuItemSelected" Color="#FF3875D6" />
      <SolidColorBrush x:Key="JbMenuItemSelectedForeground" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="JbMenuSeparator" Color="#FFCDCDCD" />

      <!-- Tabs -->
      <SolidColorBrush x:Key="JbTabStripBackground" Color="#FFF2F2F2" />
      <SolidColorBrush x:Key="JbTabHoverBackground" Color="#FFE3E3E3" />
      <SolidColorBrush x:Key="JbTabSelectedBackground" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="JbTabSelectedUnderline" Color="#FF4083C9" />

      <!-- Table rows -->
      <SolidColorBrush x:Key="JbListItemHover" Color="#FFEDF3FE" />
      <SolidColorBrush x:Key="JbListItemSelected" Color="#FF3875D6" />
      <SolidColorBrush x:Key="JbListItemSelectedForeground" Color="#FFFFFFFF" />

      <!-- Inline validation text; see the Dark dictionary. Darker here so it keeps its contrast
           against a white form. -->
      <SolidColorBrush x:Key="JbErrorForeground" Color="#FFC0392B" />

      <!-- The console on the light face; see the Dark dictionary. The sixteen are darkened rather
           than swapped, because a terminal colour has to keep its identity (red is red) while
           gaining enough contrast to be read on white. -->
      <SolidColorBrush x:Key="JbTerminalBackground" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="JbTerminalForeground" Color="#FF2B2B2B" />
      <SolidColorBrush x:Key="JbTerminalSelection" Color="#FFA6D2FF" />
      <SolidColorBrush x:Key="JbTerminalCursor" Color="#FF2B2B2B" />
      <Color x:Key="JbTerminal0">#FF000000</Color>
      <Color x:Key="JbTerminal1">#FFCD3131</Color>
      <Color x:Key="JbTerminal2">#FF00A000</Color>
      <Color x:Key="JbTerminal3">#FF949800</Color>
      <Color x:Key="JbTerminal4">#FF0451A5</Color>
      <Color x:Key="JbTerminal5">#FFBC05BC</Color>
      <Color x:Key="JbTerminal6">#FF0598BC</Color>
      <Color x:Key="JbTerminal7">#FF555555</Color>
      <Color x:Key="JbTerminal8">#FF666666</Color>
      <Color x:Key="JbTerminal9">#FFCD3131</Color>
      <Color x:Key="JbTerminal10">#FF14CE14</Color>
      <Color x:Key="JbTerminal11">#FFB5BA00</Color>
      <Color x:Key="JbTerminal12">#FF0451A5</Color>
      <Color x:Key="JbTerminal13">#FFBC05BC</Color>
      <Color x:Key="JbTerminal14">#FF0598BC</Color>
      <Color x:Key="JbTerminal15">#FF000000</Color>
    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>

  <!-- Group box. Deliberately outside the theme dictionaries: both are grey with an alpha channel,
       so one pair of values reads correctly on the light and the dark face alike, which is why this
       has been the app's group-box idiom since before it had a name. -->
  <SolidColorBrush x:Key="JbGroupBoxBorder" Color="#33808080" />
  <SolidColorBrush x:Key="JbGroupBoxHeader" Color="#11808080" />

  <!-- The add and remove glyphs of an editable list's tool strip, IntelliJ's own two. Outside the
       theme dictionaries for the same reason the two above are: both are saturated enough to read
       on either face, and a green that means "add" should not change meaning with the theme. -->
  <SolidColorBrush x:Key="JbIconAdd" Color="#59A869" />
  <SolidColorBrush x:Key="JbIconRemove" Color="#C75450" />

  <!--
    THE font size for the whole app. Avalonia gives a bare TextBlock 12, while every Fluent
    ControlTheme sets its own FontSize from this key (14), so labels and the controls they label
    were rendering two points apart, and each retemplated control here (which drops that setter and
    falls back to the inherited 12) widened the gap. Pulling the key down to 12 puts the controls we
    have NOT retemplated (text fields, dropdowns, spinners, list items, menus, tooltips) on the
    same baseline as the labels, so views never need a local FontSize to line things up.
    Control metrics below are all sized for this 12: 24px fields and buttons, a 14px check box.
  -->
  <x:Double x:Key="ControlContentThemeFontSize">12</x:Double>

  <!-- Shared metrics. The border stays 1px on focus; Fluent thickens it to an accent underline,
       JetBrains just recolours it. -->
  <CornerRadius x:Key="ControlCornerRadius">3</CornerRadius>
  <Thickness x:Key="TextControlBorderThemeThickness">1</Thickness>
  <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
  <Thickness x:Key="TextControlThemePadding">6,3</Thickness>
  <!-- 24, the same box the Button theme below draws: a field and the button beside it have the same
       1px border and the same 3px vertical inset around a 12pt line, so one shared height lines the
       two up exactly. Fluent's own 32 (and the 26 this used to carry) left fields standing proud of
       every button they sat next to. Anything that has to match a field by hand (the "…" button in
       RemotePathBox) is sized off this number, not off its own guess. -->
  <x:Double x:Key="TextControlThemeMinHeight">24</x:Double>

  <!-- Dropdown metrics, matched to the text field above: same 1px hairline, same 24px box, same
       6,3 inset. The right inset is 0 because the chevron sits in its own column and brings its
       own margin. Fluent's roomy popup padding is dropped so the list rows read as a JetBrains
       pick-list rather than a WinUI flyout. -->
  <Thickness x:Key="ComboBoxBorderThemeThickness">1</Thickness>
  <Thickness x:Key="ComboBoxPadding">6,3,0,3</Thickness>
  <x:Double x:Key="ComboBoxMinHeight">24</x:Double>
  <Thickness x:Key="ComboBoxItemThemePadding">6,3</Thickness>
  <Thickness x:Key="ComboBoxDropdownBorderThickness">1</Thickness>
  <Thickness x:Key="ComboBoxDropdownBorderPadding">0,2</Thickness>
  <Thickness x:Key="ComboBoxDropdownContentMargin">0</Thickness>

  <!-- The rest of Fluent's touch-sized metrics, brought down to the same scale. These are the
       surfaces with no JetBrains template of their own: ordinary pick-lists (the remote file
       browser, the dialog disk lists) and tooltips. Fluent sizes them for a 14pt font and a
       fingertip; at 12pt they read as bloated next to the tables and toolbars. (Menus used to be
       retuned by key here too; they have their own templates at the bottom of this file now.) -->
  <Thickness x:Key="ListBoxItemPadding">8,4</Thickness>
  <Thickness x:Key="ToolTipBorderThemePadding">6,3,6,4</Thickness>
  <x:Double x:Key="TreeViewItemMinHeight">24</x:Double>

  <!-- A status bar keeps this height whether it holds text alone or a progress bar and a button, so
       nothing below it reflows. In the console that is not cosmetic: a status row that grows shrinks
       the SPICE display, which fires SizeChanged and asks the guest for a mode set. 24 is a 16px
       row (the tallest thing a status bar carries, see JbStatusBarButton) inside the usual 4px
       vertical padding. -->
  <x:Double x:Key="JbStatusBarMinHeight">24</x:Double>

  <!-- The tick is white on the accent fill in both themes, so it is not a per-theme brush. -->
  <SolidColorBrush x:Key="JbCheckBoxGlyph" Color="#FFFFFFFF" />

  <ControlTheme x:Key="{x:Type Button}" TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource JbButtonBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource JbButtonBorder}" />
    <Setter Property="Foreground" Value="{DynamicResource JbButtonForeground}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="14,3" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="MinWidth" Value="72" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <!-- The border itself carries the focus colour, so Fluent's dashed adorner is redundant. -->
    <Setter Property="FocusAdorner" Value="{x:Null}" />

    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Root"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <ContentPresenter Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            RecognizesAccessKey="True" />
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{DynamicResource JbButtonBackgroundHover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource JbButtonBorderHover}" />
    </Style>

    <Style Selector="^:pressed">
      <Setter Property="Background" Value="{DynamicResource JbButtonBackgroundPressed}" />
      <Setter Property="BorderBrush" Value="{DynamicResource JbButtonBorderHover}" />
    </Style>

    <Style Selector="^:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource JbButtonFocusBorder}" />
    </Style>

    <Style Selector="^:disabled">
      <Setter Property="Background" Value="{DynamicResource JbButtonBackgroundDisabled}" />
      <Setter Property="BorderBrush" Value="{DynamicResource JbButtonBorderDisabled}" />
      <Setter Property="Foreground" Value="{DynamicResource JbButtonForegroundDisabled}" />
    </Style>

    <!-- Default button (Classes="accent"). Last so it wins over the neutral states above. -->
    <Style Selector="^.accent">
      <Setter Property="Background" Value="{DynamicResource JbDefaultButtonBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource JbDefaultButtonBorder}" />
      <Setter Property="Foreground" Value="{DynamicResource JbDefaultButtonForeground}" />

      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{DynamicResource JbDefaultButtonBackgroundHover}" />
      </Style>

      <Style Selector="^:pressed">
        <Setter Property="Background" Value="{DynamicResource JbDefaultButtonBackgroundPressed}" />
      </Style>

      <Style Selector="^:focus-visible">
        <Setter Property="BorderBrush" Value="{DynamicResource JbButtonFocusBorder}" />
      </Style>

      <Style Selector="^:disabled">
        <Setter Property="Background" Value="{DynamicResource JbButtonBackgroundDisabled}" />
        <Setter Property="BorderBrush" Value="{DynamicResource JbButtonBorderDisabled}" />
        <Setter Property="Foreground" Value="{DynamicResource JbButtonForegroundDisabled}" />
      </Style>
    </Style>
  </ControlTheme>

  <!--
    A square button holding a glyph instead of a label: the same bordered cell as an ordinary
    button, so the two sit in one strip, shrunk to the 24 every field and button in the app already
    shares. MinWidth matches that height and the padding goes, which is the whole of "square"; the
    16x16 glyph then centres itself in it.

    A glyph in one of these must bind its Stroke to `$parent[Button].Foreground` rather than to
    JbButtonForeground directly, or it stays at full strength while the button is disabled, and
    Back and Forward spend most of their life disabled.
  -->
  <ControlTheme x:Key="JbIconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="MinWidth" Value="24" />
    <Setter Property="Padding" Value="0" />
  </ControlTheme>

  <!--
    Toolbar button: the same flat cell a top-level MenuItem draws, so a plain command can sit next
    to the dropdowns in one strip without looking like a dialog button. Keyed rather than implicit;
    the bordered Button above stays the default everywhere else.
  -->
  <ControlTheme x:Key="JbToolButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource JbButtonForeground}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />

    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Root"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <ContentPresenter Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            RecognizesAccessKey="True" />
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{DynamicResource JbToolBarItemHover}" />
    </Style>

    <Style Selector="^:pressed">
      <Setter Property="Background" Value="{DynamicResource JbToolBarItemPressed}" />
    </Style>

    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource JbButtonForegroundDisabled}" />
    </Style>
  </ControlTheme>

  <!--
    The same flat cell, shrunk to fit a status bar: 16px so the row it sits in is exactly
    JbStatusBarMinHeight and the bar does not grow when a transfer's Cancel appears.
  -->
  <ControlTheme x:Key="JbStatusBarButton" TargetType="Button" BasedOn="{StaticResource JbToolButton}">
    <Setter Property="MinHeight" Value="16" />
    <Setter Property="Padding" Value="8,0" />
  </ControlTheme>

  <!--
    A sortable column heading: the same flat cell again, but reading as the heading strip's text
    rather than as a control, so a table whose columns sort looks identical to one whose columns do
    not until the pointer is over it. The strip's own 12,3 already insets it, hence no padding of
    its own, and the row height comes from the strip, hence MinHeight 0.
  -->
  <ControlTheme x:Key="JbColumnHeader" TargetType="Button" BasedOn="{StaticResource JbToolButton}">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </ControlTheme>

  <!--
    Check box. Fluent's is a 20px box inside a 32px row, a touch target, not a desktop control.
    JetBrains draws a 14px square that sits on the text baseline. The box size is hard-coded in
    Fluent's template (not a resource), so shrinking it means replacing the template outright.
    The tick is a stroked Path rather than a filled glyph: at 14px a stroke stays crisp where a
    scaled-down filled outline turns to mush.
  -->
  <ControlTheme x:Key="{x:Type CheckBox}" TargetType="CheckBox">
    <Setter Property="Background" Value="{DynamicResource TextControlBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TextControlBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource JbButtonForeground}" />
    <Setter Property="Padding" Value="6,0,0,0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />

    <Setter Property="Template">
      <ControlTemplate>
        <Grid ColumnDefinitions="Auto,*" Background="Transparent">
          <Border Name="Box" Grid.Column="0"
                  Width="14" Height="14" CornerRadius="2"
                  VerticalAlignment="Center"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1">
            <Panel>
              <Path Name="Check" IsVisible="False"
                    Stroke="{DynamicResource JbCheckBoxGlyph}" StrokeThickness="1.6"
                    StrokeLineCap="Round" StrokeJoin="Round"
                    Data="M 2.5,6.25 L 4.75,8.75 L 9.5,3.25" />
              <Rectangle Name="Dash" IsVisible="False"
                         Width="8" Height="2" RadiusX="1" RadiusY="1"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Fill="{DynamicResource JbCheckBoxGlyph}" />
            </Panel>
          </Border>
          <ContentPresenter Name="PART_ContentPresenter" Grid.Column="1"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Grid>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover /template/ Border#Box">
      <Setter Property="BorderBrush" Value="{DynamicResource TextControlBorderBrushPointerOver}" />
    </Style>

    <Style Selector="^:focus-visible /template/ Border#Box">
      <Setter Property="BorderBrush" Value="{DynamicResource JbButtonFocusBorder}" />
    </Style>

    <Style Selector="^:checked, ^:indeterminate">
      <Style Selector="^ /template/ Border#Box">
        <Setter Property="Background" Value="{DynamicResource JbDefaultButtonBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource JbDefaultButtonBorder}" />
      </Style>
      <Style Selector="^:pointerover /template/ Border#Box">
        <Setter Property="Background" Value="{DynamicResource JbDefaultButtonBackgroundHover}" />
      </Style>
    </Style>

    <Style Selector="^:checked /template/ Path#Check">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="^:indeterminate /template/ Rectangle#Dash">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource JbButtonForegroundDisabled}" />
      <Style Selector="^ /template/ Border#Box">
        <Setter Property="Background" Value="{DynamicResource TextControlBackgroundDisabled}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TextControlBorderBrushDisabled}" />
      </Style>
    </Style>
  </ControlTheme>

  <!--
    Radio button: the check box above, rounded. Same 14px box, same accent fill, same states, so a
    dialog that mixes the two (the create wizard does) keeps one control height throughout.
  -->
  <ControlTheme x:Key="{x:Type RadioButton}" TargetType="RadioButton">
    <Setter Property="Background" Value="{DynamicResource TextControlBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TextControlBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource JbButtonForeground}" />
    <Setter Property="Padding" Value="6,0,0,0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />

    <Setter Property="Template">
      <ControlTemplate>
        <Grid ColumnDefinitions="Auto,*" Background="Transparent">
          <Panel Grid.Column="0" Width="14" Height="14" VerticalAlignment="Center">
            <Ellipse Name="Box"
                     Fill="{TemplateBinding Background}"
                     Stroke="{TemplateBinding BorderBrush}"
                     StrokeThickness="1" />
            <!--
              The dot must be an even size inside the even 14px box: an odd one leaves a 4.5px
              margin, which layout rounding snaps to 4 on one side and 5 on the other, so the dot
              sits visibly off centre.
            -->
            <Ellipse Name="Dot" IsVisible="False"
                     Width="6" Height="6"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Fill="{DynamicResource JbCheckBoxGlyph}" />
          </Panel>
          <ContentPresenter Name="PART_ContentPresenter" Grid.Column="1"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Grid>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover /template/ Ellipse#Box">
      <Setter Property="Stroke" Value="{DynamicResource TextControlBorderBrushPointerOver}" />
    </Style>

    <Style Selector="^:focus-visible /template/ Ellipse#Box">
      <Setter Property="Stroke" Value="{DynamicResource JbButtonFocusBorder}" />
    </Style>

    <Style Selector="^:checked">
      <Style Selector="^ /template/ Ellipse#Box">
        <Setter Property="Fill" Value="{DynamicResource JbDefaultButtonBackground}" />
        <Setter Property="Stroke" Value="{DynamicResource JbDefaultButtonBorder}" />
      </Style>
      <Style Selector="^ /template/ Ellipse#Dot">
        <Setter Property="IsVisible" Value="True" />
      </Style>
      <Style Selector="^:pointerover /template/ Ellipse#Box">
        <Setter Property="Fill" Value="{DynamicResource JbDefaultButtonBackgroundHover}" />
      </Style>
    </Style>

    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource JbButtonForegroundDisabled}" />
      <Style Selector="^ /template/ Ellipse#Box">
        <Setter Property="Fill" Value="{DynamicResource TextControlBackgroundDisabled}" />
        <Setter Property="Stroke" Value="{DynamicResource TextControlBorderBrushDisabled}" />
      </Style>
    </Style>
  </ControlTheme>

  <!--
    Tabs. Fluent draws big rounded cards with an accent pill, the Windows 8 look. JetBrains draws a
    flat strip of square cells, ruled off from the content by a hairline, with the selected cell
    marked by a 2px underline. The underline border is always present (transparent when unselected)
    so selecting a tab does not shift its label by two pixels.
    Both TabControls in the app are top-placed, so the template does not handle TabStripPlacement.
  -->
  <ControlTheme x:Key="{x:Type TabControl}" TargetType="TabControl">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal" />
      </ItemsPanelTemplate>
    </Setter>

    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}">
          <DockPanel>
            <Border DockPanel.Dock="Top"
                    Background="{DynamicResource JbTabStripBackground}"
                    BorderBrush="{DynamicResource JbToolBarBorder}"
                    BorderThickness="0,0,0,1">
              <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
            </Border>
            <ContentPresenter Name="PART_SelectedContentHost"
                              Content="{TemplateBinding SelectedContent}"
                              ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                              Margin="{TemplateBinding Padding}" />
          </DockPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type TabItem}" TargetType="TabItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource JbButtonForeground}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Padding" Value="12,4" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />

    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Root"
                Background="{TemplateBinding Background}"
                BorderBrush="Transparent"
                BorderThickness="0,0,0,2">
          <ContentPresenter Name="PART_ContentPresenter"
                            Content="{TemplateBinding Header}"
                            ContentTemplate="{TemplateBinding HeaderTemplate}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover /template/ Border#Root">
      <Setter Property="Background" Value="{DynamicResource JbTabHoverBackground}" />
    </Style>

    <Style Selector="^:selected /template/ Border#Root">
      <Setter Property="Background" Value="{DynamicResource JbTabSelectedBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource JbTabSelectedUnderline}" />
    </Style>

    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource JbButtonForegroundDisabled}" />
    </Style>
  </ControlTheme>

  <!--
    Side tabs: the same strip stood on its end, for a settings window whose section list is long
    enough that a top strip would wrap. A sibling of the pair above rather than an edit to it,
    because that template deliberately does not handle TabStripPlacement.

    The differences from the top-placed pair: the items panel is vertical, the hairline moves from
    under the strip to its right edge, the selected marker moves from a 2px underline to a 2px bar
    on the left, and items stretch to the strip's width so the selection fill is a full row. The
    strip scrolls: the tab count is expected to grow.
  -->
  <ControlTheme x:Key="JbSideTabItem" TargetType="TabItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource JbButtonForeground}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />

    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Root"
                Background="{TemplateBinding Background}"
                BorderBrush="Transparent"
                BorderThickness="2,0,0,0">
          <ContentPresenter Name="PART_ContentPresenter"
                            Content="{TemplateBinding Header}"
                            ContentTemplate="{TemplateBinding HeaderTemplate}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover /template/ Border#Root">
      <Setter Property="Background" Value="{DynamicResource JbTabHoverBackground}" />
    </Style>

    <Style Selector="^:selected /template/ Border#Root">
      <Setter Property="Background" Value="{DynamicResource JbTabSelectedBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource JbTabSelectedUnderline}" />
    </Style>

    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource JbButtonForegroundDisabled}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="JbSideTabControl" TargetType="TabControl">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ItemContainerTheme" Value="{StaticResource JbSideTabItem}" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Vertical" />
      </ItemsPanelTemplate>
    </Setter>

    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}">
          <DockPanel>
            <Border DockPanel.Dock="Left"
                    MinWidth="160"
                    Background="{DynamicResource JbTabStripBackground}"
                    BorderBrush="{DynamicResource JbToolBarBorder}"
                    BorderThickness="0,0,1,0">
              <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
              </ScrollViewer>
            </Border>
            <ContentPresenter Name="PART_SelectedContentHost"
                              Content="{TemplateBinding SelectedContent}"
                              ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                              Margin="{TemplateBinding Padding}" />
          </DockPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!--
    Module tabs: the main window's side menu, which is the side-tab strip above carrying an icon
    beside each label. Derived rather than copied, so the strip metrics (160px, the right-edge
    hairline, the 2px left selection bar) stay defined once; the only difference is a row tall
    enough for a 16px glyph to sit in without crowding the text.

    Header is content, not a string, so the icon lives in the caller's markup and this theme knows
    nothing about it.
  -->
  <ControlTheme x:Key="JbModuleTabItem" TargetType="TabItem" BasedOn="{StaticResource JbSideTabItem}">
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="MinHeight" Value="34" />
  </ControlTheme>

  <ControlTheme x:Key="JbModuleTabControl" TargetType="TabControl" BasedOn="{StaticResource JbSideTabControl}">
    <Setter Property="ItemContainerTheme" Value="{StaticResource JbModuleTabItem}" />
  </ControlTheme>

  <!--
    Group box: a titled frame with a header strip, which is what every settings page in this app
    draws by hand. Given a ControlTheme because the answer-file window alone has a few dozen of
    them; eight lines of Border/DockPanel markup repeated that many times is where an idiom starts
    drifting. Header is content, not a string property, so a page can put a checkbox in it later.
  -->
  <ControlTheme x:Key="JbGroupBox" TargetType="HeaderedContentControl">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <!-- The inset around the contents, templated rather than hardcoded so a box whose whole content
         is a table can ask for none and let the rows run to the frame. Anything else would put a
         second border a few pixels inside the first, which reads as a mistake. -->
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border BorderThickness="1" BorderBrush="{DynamicResource JbGroupBoxBorder}" CornerRadius="3">
          <DockPanel>
            <Border DockPanel.Dock="Top" Padding="12,3"
                    Background="{DynamicResource JbGroupBoxHeader}">
              <ContentPresenter Content="{TemplateBinding Header}"
                                ContentTemplate="{TemplateBinding HeaderTemplate}"
                                TextElement.FontWeight="SemiBold" />
            </Border>
            <ContentPresenter Name="PART_ContentPresenter" Margin="{TemplateBinding Padding}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}" />
          </DockPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!--
    Table row: the tight, square, full-width row a DataGrip/Rider grid draws, ~20px, no corner
    radius, no inset selection pill. Keyed rather than implicit so ordinary pick-lists elsewhere
    (dialogs, the file browser) keep Fluent's roomier item.
  -->
  <ControlTheme x:Key="JbTableRow" TargetType="ListBoxItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource JbButtonForeground}" />
    <Setter Property="Padding" Value="12,4" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />

    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Root"
                Background="{TemplateBinding Background}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover /template/ Border#Root">
      <Setter Property="Background" Value="{DynamicResource JbListItemHover}" />
    </Style>

    <Style Selector="^:selected /template/ Border#Root">
      <Setter Property="Background" Value="{DynamicResource JbListItemSelected}" />
    </Style>

    <Style Selector="^:selected">
      <Setter Property="Foreground" Value="{DynamicResource JbListItemSelectedForeground}" />
    </Style>
  </ControlTheme>

  <!--
    The same row, for a table that is typed into rather than picked from (the container editor's
    volumes, ports, variables and devices).

    Two differences, both about the keyboard. A selector is one tab stop by design, which is right
    for a list you pick from and wrong for a grid of text boxes: Tab has to walk the cells, so the
    row stops being a navigation boundary. And the row itself stops being a tab stop, or every row
    would cost an extra Tab press on the way to its first cell. It stays focusable, so clicking and
    the arrow keys still select.
  -->
  <ControlTheme x:Key="JbFormRow" TargetType="ListBoxItem" BasedOn="{StaticResource JbTableRow}">
    <Setter Property="KeyboardNavigation.TabNavigation" Value="Continue" />
    <Setter Property="IsTabStop" Value="False" />
  </ControlTheme>

  <!--
    Menus. Fluent draws a WinUI flyout: a rounded, shadowed card whose highlighted row is an inset
    gray pill with rounded corners, sized for a fingertip. JetBrains Classic draws a square popup on
    the window face inside a 1px hairline, ~22px rows, and highlights the row edge-to-edge in the
    same selection blue the tables use. Retemplated rather than recoloured because the geometry
    (corner radius, the inset pill, the icon gutter) is baked into Fluent's template.

    Three themes work together: the item below is the popup row (context menus and submenus),
    JbTopLevelMenuItem is the cell in a menu bar or toolbar strip, and the Menu theme wires the two
    together through ItemContainerTheme. Items nested inside a top-level item get no explicit
    container theme, so they fall back to this implicit one, which is what makes a toolbar dropdown
    look like a context menu.
  -->
  <ControlTheme x:Key="{x:Type MenuItem}" TargetType="MenuItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource JbMenuForeground}" />
    <!-- Wide right inset: the label must not run up against the popup's frame, and it leaves the
         submenu triangle a lane of its own. -->
    <Setter Property="Padding" Value="6,3,20,3" />
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />

    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Name="Root"
                  Background="{TemplateBinding Background}"
                  Padding="{TemplateBinding Padding}">
            <!-- The 18px gutter is reserved whether or not anything is in it, so the labels of a
                 menu that mixes plain and checkable items still line up (JetBrains does the same). -->
            <Grid ColumnDefinitions="18,*,Auto,Auto">
              <Panel Grid.Column="0" VerticalAlignment="Center">
                <ContentPresenter Name="PART_IconPresenter" IsVisible="False"
                                  Content="{TemplateBinding Icon}"
                                  Width="14" Height="14"
                                  HorizontalAlignment="Left" VerticalAlignment="Center" />
                <!-- Stroked from the row's own Foreground, so the tick turns white with the text
                     when the row is highlighted instead of vanishing into the blue. -->
                <Path Name="Check" IsVisible="False"
                      Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6"
                      StrokeLineCap="Round" StrokeJoin="Round"
                      HorizontalAlignment="Left" VerticalAlignment="Center"
                      Data="M 1,5.5 L 3.5,8 L 8.5,2" />
                <Ellipse Name="Dot" IsVisible="False"
                         Width="6" Height="6"
                         HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0"
                         Fill="{TemplateBinding Foreground}" />
              </Panel>

              <ContentPresenter Name="PART_HeaderPresenter" Grid.Column="1"
                                Content="{TemplateBinding Header}"
                                ContentTemplate="{TemplateBinding HeaderTemplate}"
                                Foreground="{TemplateBinding Foreground}"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />

              <!-- The chord an item names, when it names one. The lane is the theme's job rather
                   than each view spelling "Ctrl+X" into its own Header: Fluent's MenuItem has this
                   column and this retemplate had dropped it, so InputGesture drew nothing anywhere
                   in the app, including in the cut/copy/paste flyout a TextBox brings with it. -->
              <TextBlock Name="PART_InputGestureText" Grid.Column="2"
                         Text="{TemplateBinding InputGesture}"
                         IsVisible="{TemplateBinding InputGesture, Converter={x:Static ObjectConverters.IsNotNull}}"
                         Foreground="{TemplateBinding Foreground}" Opacity="0.65"
                         Margin="20,0,0,0" VerticalAlignment="Center" />

              <!-- Filled triangle, the classic submenu marker; hidden on leaf items (:empty). -->
              <Path Name="Chevron" Grid.Column="3"
                    Fill="{TemplateBinding Foreground}"
                    Margin="14,0,0,0" VerticalAlignment="Center"
                    Data="M 0,0 L 4,3.5 L 0,7 Z" />
            </Grid>
          </Border>

          <Popup Name="PART_Popup"
                 IsLightDismissEnabled="False"
                 IsOpen="{TemplateBinding IsSubMenuOpen, Mode=TwoWay}"
                 Placement="RightEdgeAlignedTop"
                 HorizontalOffset="-1" VerticalOffset="-5">
            <Border Background="{DynamicResource JbMenuBackground}"
                    BorderBrush="{DynamicResource JbMenuBorder}"
                    BorderThickness="1"
                    Padding="0,4">
              <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
            </Border>
          </Popup>
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:icon /template/ ContentPresenter#PART_IconPresenter">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="^:empty /template/ Path#Chevron">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="^:toggle:checked /template/ Path#Check">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="^:radio:checked /template/ Ellipse#Dot">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <!-- Keyboard walking sets :selected, the pointer sets :pointerover; both paint the same row. -->
    <Style Selector="^:selected, ^:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource JbMenuItemSelectedForeground}" />
      <Style Selector="^ /template/ Border#Root">
        <Setter Property="Background" Value="{DynamicResource JbMenuItemSelected}" />
      </Style>
    </Style>

    <!-- Last, so a disabled row stays gray on its own face even while the pointer is over it. -->
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource JbMenuForegroundDisabled}" />
      <Style Selector="^ /template/ Border#Root">
        <Setter Property="Background" Value="Transparent" />
      </Style>
    </Style>
  </ControlTheme>

  <!--
    Menu separator: a full-width hairline. JetBrains rules right across the popup rather than
    insetting the line like Fluent; the app uses Separator only inside menus.
  -->
  <ControlTheme x:Key="{x:Type Separator}" TargetType="Separator">
    <Setter Property="Background" Value="{DynamicResource JbMenuSeparator}" />
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="0,4" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!--
    Top-level cell of a menu bar / toolbar strip: the flat borderless box JbToolButton draws, so a
    dropdown and a plain command button sit in one strip at one height. The dropdown marker is the
    small chevron an old JetBrains toolbar button carries; a leaf item (:empty, the console's USB
    entry) is a plain button and shows none.
  -->
  <ControlTheme x:Key="JbTopLevelMenuItem" TargetType="MenuItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource JbButtonForeground}" />
    <Setter Property="Padding" Value="9,3" />
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />

    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Name="Root"
                  Background="{TemplateBinding Background}"
                  Padding="{TemplateBinding Padding}"
                  CornerRadius="3">
            <StackPanel Orientation="Horizontal">
              <ContentPresenter Name="PART_HeaderPresenter"
                                Content="{TemplateBinding Header}"
                                ContentTemplate="{TemplateBinding HeaderTemplate}"
                                Foreground="{TemplateBinding Foreground}"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
              <Path Name="Chevron"
                    Fill="{TemplateBinding Foreground}"
                    Margin="6,1,0,0" VerticalAlignment="Center" Opacity="0.8"
                    Data="M 0,0 L 7,0 L 3.5,4 Z" />
            </StackPanel>
          </Border>

          <Popup Name="PART_Popup"
                 IsLightDismissEnabled="False"
                 IsOpen="{TemplateBinding IsSubMenuOpen, Mode=TwoWay}"
                 Placement="BottomEdgeAlignedLeft"
                 OverlayInputPassThroughElement="{Binding $parent[Menu]}">
            <Border Background="{DynamicResource JbMenuBackground}"
                    BorderBrush="{DynamicResource JbMenuBorder}"
                    BorderThickness="1"
                    Padding="0,4">
              <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
            </Border>
          </Popup>
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:empty /template/ Path#Chevron">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="^:pointerover /template/ Border#Root">
      <Setter Property="Background" Value="{DynamicResource JbToolBarItemHover}" />
    </Style>

    <!-- An open dropdown keeps its cell pressed in, so it is obvious which one is showing. -->
    <Style Selector="^:open /template/ Border#Root">
      <Setter Property="Background" Value="{DynamicResource JbToolBarItemPressed}" />
    </Style>

    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource JbButtonForegroundDisabled}" />
      <Style Selector="^ /template/ Border#Root">
        <Setter Property="Background" Value="Transparent" />
      </Style>
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type Menu}" TargetType="Menu">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ItemContainerTheme" Value="{StaticResource JbTopLevelMenuItem}" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal" />
      </ItemsPanelTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                Padding="{TemplateBinding Padding}">
          <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}"
                          KeyboardNavigation.TabNavigation="Continue" />
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type ContextMenu}" TargetType="ContextMenu">
    <Setter Property="Background" Value="{DynamicResource JbMenuBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource JbMenuBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="0,4" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                Padding="{TemplateBinding Padding}">
          <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}"
                          KeyboardNavigation.TabNavigation="Continue" />
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- Not used by a view of ours, but a TextBox brings its own cut/copy/paste flyout: same frame,
       so that one menu does not arrive in Fluent trim. -->
  <ControlTheme x:Key="{x:Type MenuFlyoutPresenter}" TargetType="MenuFlyoutPresenter">
    <Setter Property="Background" Value="{DynamicResource JbMenuBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource JbMenuBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="0,4" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                Padding="{TemplateBinding Padding}">
          <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}"
                          KeyboardNavigation.TabNavigation="Continue" />
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

</ResourceDictionary>
