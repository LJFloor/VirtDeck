<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>VirtDeck.Avalonia</RootNamespace>
    <AssemblyName>virtdeck</AssemblyName>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Shell icon baked into virtdeck.exe. Ignored when the apphost is not a Windows PE, so it
         costs nothing on the Linux publish. See packaging/icons/make-icons.py. -->
    <ApplicationIcon>Assets\virtdeck.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RuntimeIdentifiers>linux-x64;win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <!-- 12.1 is the floor for Linux: X11 drag-and-drop (XDND) landed in 12.1.0; 12.0.x raises no
         drop events at all on X11, so the console's file drops would be Windows-only. -->
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <!-- Rasterises Linux icon-theme SVGs for the remote file browser (Services/LinuxFileIcons).
         Papirus, Breeze and Adwaita 46+ ship mimetype icons as SVG only, and Avalonia renders none
         of it on its own. 5.1.1 wants SkiaSharp >= 3.119.2 and SpiceClient already pins 3.119.4, so
         this bumps no version and adds no native library. Unused on Windows, where the shell hands
         over pixels directly; carried anyway rather than compile the app differently per RID. -->
    <PackageReference Include="Svg.Skia" Version="5.1.1" />
    <!-- The compose YAML editor on the Containers module's Stacks tab. Avalonia's TextBox is a
         text box: no line numbers, no highlighting, and no tab key, and YAML is the one format in
         this app where a literal tab is a syntax error. 12.0.0 targets net10.0 and asks for
         Avalonia >= 12.0.0, which the 12.1.1 above satisfies; the managed assembly is 648 KB.
         AvaloniaEdit.TextMate is deliberately NOT taken: it would pull the whole TextMateSharp
         grammar bundle in to highlight one language, and Styles/Yaml.xshd does it in 60 lines.
         The answer-file window's script and markup boxes are the same editor, five of them on the
         definitions AvaloniaEdit already ships. -->
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VirtDeck.Core\VirtDeck.Core.csproj" />
    <ProjectReference Include="..\SpiceClient\SpiceClient.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!-- The three syntax definitions this app writes itself, read at run time by
         Controls/CodeHighlighting. Resources rather than embedded strings so they stay editable as
         XML. The other five languages come from AvaloniaEdit's own resources. -->
    <AvaloniaResource Include="Styles\*.xshd" />
    <!-- The .ico is a build input for <ApplicationIcon>, not a runtime asset; embedding it as
         well would carry a second copy of every frame in the assembly for nothing. -->
    <AvaloniaResource Remove="Assets\virtdeck.ico" />
  </ItemGroup>

  <!-- USB redirection needs the native libusb/usbredir libraries. On Windows they ship with the
       app (staged in native\win-x64); on Linux they come from the distro packages. -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64' Or '$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Windows)))' == 'true'">
    <None Include="..\native\win-x64\*.dll">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Pack>false</Pack>
    </None>
  </ItemGroup>

</Project>
